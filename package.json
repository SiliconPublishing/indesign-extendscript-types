{
  "name": "indesign-extendscript-types",
  "version": "21.6.0",
  "description": "TypeScript declarations for the Adobe InDesign ExtendScript DOM, converted from indesign-uxp-types and measured against InDesign.",
  "author": "Jeremiah Lynn",
  "license": "MIT",
  "homepage": "https://github.com/SiliconPublishing/indesign-extendscript-types#readme",
  "bugs": {
    "url": "https://github.com/SiliconPublishing/indesign-extendscript-types/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiliconPublishing/indesign-extendscript-types.git"
  },
  "keywords": [
    "indesign",
    "adobe",
    "extendscript",
    "jsx",
    "typescript",
    "types",
    "scripting"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./authored": {
      "types": "./authored.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "authored": [
        "./authored.d.ts"
      ]
    }
  },
  "files": [
    "index.d.ts",
    "authored.d.ts",
    "lib/",
    "types/",
    "flat/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "fast-xml-parser": "^5.11.2",
    "ts-morph": "^28.0.0",
    "typescript": "5.9"
  },
  "scripts": {
    "dump": "node tools/dump/index.mjs",
    "dump:runtime": "node tools/dump/runtime.mjs",
    "dump:writes": "node tools/dump/runtime.mjs --writes",
    "codemod": "node tools/codemod/index.mjs",
    "build": "node tools/codemod/index.mjs",
    "compare": "node tools/compare/index.mjs --json reports/findings.json",
    "test": "node test/run.mjs",
    "test:live": "node test/run.mjs --live",
    "report": "node tools/report.mjs",
    "verify:flatten": "node tools/flatten/verify.mjs",
    "plugin": "node tools/plugin/index.mjs"
  }
}
