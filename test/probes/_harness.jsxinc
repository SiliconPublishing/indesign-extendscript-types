// Probe harness: each probe asserts one measured fact the declarations rely on.
//   probe('name', function () { ...; return actualValue; }, expectedValue)
// expected may be a function(actual) -> boolean. A probe that throws records the error message
// as its actual value, so "this throws" is itself testable via didThrow().
var __results = [];
var __doc = null;

// InDesign Server has no UI (tools/editions): desktop's documents.add and app.open take
// showingWindow first, Server's do not; facts about the UI are probed on desktop only.
var onServer = /Server/.test(app.name);
function addDocument() { return onServer ? app.documents.add() : app.documents.add(false); }
function openHidden(from) { return onServer ? app.open(from) : app.open(from, false); }

// No dialogs while probing: desktop only, InDesign Server has no interaction levels. quiet()
// returns what restoreInteraction() puts back.
function quiet() {
    if (/Server/.test(app.name)) return null;
    var saved = app.scriptPreferences.userInteractionLevel;
    app.scriptPreferences.userInteractionLevel = UserInteractionLevels.NEVER_INTERACT;
    return saved;
}
function restoreInteraction(saved) { if (saved !== null) app.scriptPreferences.userInteractionLevel = saved; }

function fixtureDocument() {
    if (!__doc || !__doc.isValid) __doc = addDocument();
    return __doc;
}

function closeFixtures() {
    try { if (__doc && __doc.isValid) __doc.close(SaveOptions.NO); } catch (e) {}
    __doc = null;
}

function __same(a, b) {
    if (a instanceof Array && b instanceof Array) {
        if (a.length !== b.length) return false;
        for (var i = 0; i < a.length; i++) if (!__same(a[i], b[i])) return false;
        return true;
    }
    return a === b;
}

function probe(name, fn, expected) {
    var actual, threw = false;
    try { actual = fn(); } catch (e) { threw = true; actual = 'throws: ' + e.message; }
    var pass = typeof expected === 'function' ? !!expected(actual) : __same(actual, expected);
    // undefined is reported as "<undefined>": JSON would turn it into null.
    var show = function (v) { return v === undefined ? '<undefined>' : typeof v === 'object' && v !== null && !(v instanceof Array) ? String(v) : v; };
    var r = { name: name, pass: pass, actual: show(actual) };
    if (!pass && typeof expected !== 'function') r.expected = show(expected);
    __results.push(r);
}

/** A probe of something only InDesign desktop has: not run on InDesign Server. */
function desktopProbe(name, fn, expected) {
    if (!onServer) probe(name, fn, expected);
}

function didThrow(actual) { return typeof actual === 'string' && actual.indexOf('throws: ') === 0; }

function finish() {
    closeFixtures();
    return __results;
}
