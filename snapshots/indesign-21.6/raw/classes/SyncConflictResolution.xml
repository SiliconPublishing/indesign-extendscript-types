<classdef name="SyncConflictResolution" enumeration="true">  <shortdesc>The type of conflict resolution to employ during Version Cue synchronization.</shortdesc>  <elements type="class">    <property name="SKIP_CONFLICTS" rwaccess="readonly">      <shortdesc>Skips conflicting files.</shortdesc>      <datatype>        <type>number</type>        <value>1986216787</value>      </datatype>    </property>    <property name="ASK_ABOUT_CONFLICTS" rwaccess="readonly">      <shortdesc>Asks the user how to resolve conflicts.</shortdesc>      <datatype>        <type>number</type>        <value>1986216769</value>      </datatype>    </property>    <property name="PREFER_LOCAL" rwaccess="readonly">      <shortdesc>Uses the local version.</shortdesc>      <datatype>        <type>number</type>        <value>1986216780</value>      </datatype>    </property>    <property name="PREFER_PROJECT" rwaccess="readonly">      <shortdesc>Uses the project version.</shortdesc>      <datatype>        <type>number</type>        <value>1986216784</value>      </datatype>    </property>  </elements></classdef>