<classdef name="ICCProfiles" enumeration="true">  <shortdesc>The ICC profiles to include in the PDF document.</shortdesc>  <elements type="class">    <property name="INCLUDE_NONE" rwaccess="readonly">      <shortdesc>Does not include ICC profiles.</shortdesc>      <datatype>        <type>number</type>        <value>1229144942</value>      </datatype>    </property>    <property name="INCLUDE_ALL" rwaccess="readonly">      <shortdesc>Includes all ICC profiles.</shortdesc>      <datatype>        <type>number</type>        <value>1229144929</value>      </datatype>    </property>    <property name="INCLUDE_TAGGED" rwaccess="readonly">      <shortdesc>Includes tagged source profiles.</shortdesc>      <datatype>        <type>number</type>        <value>1229144948</value>      </datatype>    </property>    <property name="INCLUDE_RGB_AND_TAGGED" rwaccess="readonly">      <shortdesc>Includes RGB and tagged source CMYK profiles.</shortdesc>      <datatype>        <type>number</type>        <value>1229144946</value>      </datatype>    </property>  </elements></classdef>