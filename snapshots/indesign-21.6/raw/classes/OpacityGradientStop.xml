<classdef name="OpacityGradientStop" dynamic="true">  <shortdesc>An opacity gradient stop.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the OpacityGradientStop (a GradientFeatherSetting or FindChangeGradientFeatherSetting).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the OpacityGradientStop within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="opacity">      <shortdesc>The opacity of the opacity gradient stop (as a percentage). (Range: 0 to 100)</shortdesc>      <datatype>        <type>number</type>        <min>0</min>        <max>100</max>      </datatype>    </property>    <property name="location">      <shortdesc>The location of the opacity gradient stop, as a percentage of the OpacityGradientStop size. (Range: 0 to 100)</shortdesc>      <datatype>        <type>number</type>        <min>0</min>        <max>100</max>      </datatype>    </property>    <property name="midpoint">      <shortdesc>The mid-point of the opacity gradient stop, as a percentage of the OpacityGradientStop size. (Range: 13 to 87)</shortdesc>      <datatype>        <type>number</type>        <min>13</min>        <max>87</max>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the OpacityGradientStop.</shortdesc>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the OpacityGradientStop.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>OpacityGradientStop</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>