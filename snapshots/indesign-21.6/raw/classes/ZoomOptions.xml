<classdef name="ZoomOptions" enumeration="true">  <shortdesc>Display size options.</shortdesc>  <elements type="class">    <property name="ZOOM_IN" rwaccess="readonly">      <shortdesc>Magnifies the view to the next preset percentage.</shortdesc>      <datatype>        <type>number</type>        <value>2053990766</value>      </datatype>    </property>    <property name="ZOOM_OUT" rwaccess="readonly">      <shortdesc>Reduces the view to the next preset percentage.</shortdesc>      <datatype>        <type>number</type>        <value>2054124916</value>      </datatype>    </property>    <property name="FIT_SPREAD" rwaccess="readonly">      <shortdesc>Centers the active spread in the window.</shortdesc>      <datatype>        <type>number</type>        <value>2053534835</value>      </datatype>    </property>    <property name="FIT_PAGE" rwaccess="readonly">      <shortdesc>Centers the active page in the window.</shortdesc>      <datatype>        <type>number</type>        <value>2053534832</value>      </datatype>    </property>    <property name="SHOW_PASTEBOARD" rwaccess="readonly">      <shortdesc>Fits the entire pasteboard in the window.</shortdesc>      <datatype>        <type>number</type>        <value>2054385762</value>      </datatype>    </property>    <property name="ACTUAL_SIZE" rwaccess="readonly">      <shortdesc>Zooms to 100%.</shortdesc>      <datatype>        <type>number</type>        <value>2053206906</value>      </datatype>    </property>  </elements></classdef>