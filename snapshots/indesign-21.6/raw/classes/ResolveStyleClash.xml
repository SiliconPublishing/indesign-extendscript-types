<classdef name="ResolveStyleClash" enumeration="true">  <shortdesc>Options for resolving clashes that result from matching style names.</shortdesc>  <elements type="class">    <property name="RESOLVE_CLASH_USE_EXISTING" rwaccess="readonly">      <shortdesc>Uses the existing style.</shortdesc>      <datatype>        <type>number</type>        <value>2001879877</value>      </datatype>    </property>    <property name="RESOLVE_CLASH_AUTO_RENAME" rwaccess="readonly">      <shortdesc>Automatically renames the new style.</shortdesc>      <datatype>        <type>number</type>        <value>2001879873</value>      </datatype>    </property>    <property name="RESOLVE_CLASH_USE_NEW" rwaccess="readonly">      <shortdesc>Uses the new style.</shortdesc>      <datatype>        <type>number</type>        <value>2001879886</value>      </datatype>    </property>  </elements></classdef>