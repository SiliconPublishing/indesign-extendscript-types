<classdef name="GIFOptionsPalette" enumeration="true">  <shortdesc>Color palette options for GIF conversion.</shortdesc>  <elements type="class">    <property name="ADAPTIVE_PALETTE" rwaccess="readonly">      <shortdesc>Uses the adaptive (no dither) palette.</shortdesc>      <datatype>        <type>number</type>        <value>1886151024</value>      </datatype>    </property>    <property name="MACINTOSH_PALETTE" rwaccess="readonly">      <shortdesc>Uses the Macintosh palette.</shortdesc>      <datatype>        <type>number</type>        <value>1886154096</value>      </datatype>    </property>    <property name="WEB_PALETTE" rwaccess="readonly">      <shortdesc>Uses the Web palette.</shortdesc>      <datatype>        <type>number</type>        <value>1886156656</value>      </datatype>    </property>    <property name="WINDOWS_PALETTE" rwaccess="readonly">      <shortdesc>Uses the Windows palette.</shortdesc>      <datatype>        <type>number</type>        <value>1886156644</value>      </datatype>    </property>  </elements></classdef>