<classdef name="PrintBookletOption" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Print booklet options.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the PrintBookletOption (a Document).</shortdesc>      <datatype>        <type>Document</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="pageRange">      <shortdesc>The pages to print, specified either as an enumeration or a string. To specify a range, separate page numbers in the string with a hyphen (-). To specify separate pages, separate page numbers in the string with a comma (,). Can return: PageRange enumerator or String.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="bookletType">      <shortdesc>The type of booklet.</shortdesc>      <datatype>        <type>BookletTypeOptions</type>      </datatype>    </property>    <property name="spaceBetweenPages">      <shortdesc>The amount of space between pages.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>0</min>        <max>288</max>      </datatype>    </property>    <property name="bleedBetweenPages">      <shortdesc>The amount of bleed between pages.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>0</min>        <max>144</max>      </datatype>    </property>    <property name="creep">      <shortdesc>The amount of creep (binding adjustment based on paper thickness) to add.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>-144</min>        <max>144</max>      </datatype>    </property>    <property name="signatureSize">      <shortdesc>The signature size of booklet (for perfect binding).</shortdesc>      <datatype>        <type>SignatureSizeOptions</type>      </datatype>    </property>    <property name="topMargin">      <shortdesc>Top margin of the printed booklet.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>0</min>        <max>288</max>      </datatype>    </property>    <property name="bottomMargin">      <shortdesc>Bottom margin of the printed booklet.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>0</min>        <max>288</max>      </datatype>    </property>    <property name="leftMargin">      <shortdesc>Left margin of the printed booklet.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>0</min>        <max>288</max>      </datatype>    </property>    <property name="rightMargin">      <shortdesc>Right margin of the printed booklet.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>0</min>        <max>288</max>      </datatype>    </property>    <property name="autoAdjustMargins">      <shortdesc>If true, automatically adjust margins to fit the specified printer's marks and bleed area.</shortdesc>      <datatype>        <type>bool</type>        <value>true</value>      </datatype>    </property>    <property name="marginsUniformSize">      <shortdesc>If true, make all margins equal to the top margin.</shortdesc>      <datatype>        <type>bool</type>        <value>false</value>      </datatype>    </property>    <property name="printBlankPrinterSpreads">      <shortdesc>If true, print blank spreads.</shortdesc>      <datatype>        <type>bool</type>        <value>true</value>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the PrintBookletOption.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>PrintBookletOption</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>