<classdef name="DTD" dynamic="true">  <superclass href="#/XMLItem">XMLItem</superclass>  <shortdesc>The document DTD.</shortdesc>  <elements type="instance">    <property name="systemId" rwaccess="readonly">      <shortdesc>The system ID of the DOCTYPE declaration. Note: Valid only when the DTD is an external subset.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="publicId" rwaccess="readonly">      <shortdesc>The public ID of the DOCTYPE declaration. Note: Valid only when the DTD is an external subset.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="contents" rwaccess="readonly">      <shortdesc>The contents of the text. Can return: String or SpecialCharacters enumerator.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the DTD.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the DTD (a Document).</shortdesc>      <datatype>        <type>Document</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the DTD within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="rootTag">      <shortdesc>The tag of the root object.</shortdesc>      <datatype>        <type>XMLTag</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the DTD.</shortdesc>    </method>    <method name="select">      <shortdesc>Selects the object.</shortdesc>      <parameters>        <parameter name="existingSelection" optional="true">          <shortdesc>The selection status of the DTD in relation to previously selected objects. (Optional)</shortdesc>          <datatype>            <type>SelectionOptions</type>            <value>SelectionOptions.REPLACE_WITH</value>          </datatype>        </parameter>      </parameters>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the DTD.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>DTD</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>