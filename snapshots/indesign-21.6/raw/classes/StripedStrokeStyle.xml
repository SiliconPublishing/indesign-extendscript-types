<classdef name="StripedStrokeStyle" dynamic="true">  <superclass href="#/StrokeStyle">StrokeStyle</superclass>  <shortdesc>A striped stroke style.</shortdesc>  <elements type="instance">    <property name="strokeStyleType" rwaccess="readonly">      <shortdesc>The stroke style type.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the StripedStrokeStyle.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the StripedStrokeStyle (a Document or Application).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the StripedStrokeStyle within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="stripeArray">      <shortdesc>The width and position of stripes in a striped stroke pattern. Each stripe is specified by a start-end pair in the format [start1, end1, start2, end2]; each value indicates a percentage of the stroke weight. Each value must be greater than the previous value. (Range: 0 to 100).</shortdesc>      <datatype>        <type>number</type>        <array/>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the StripedStrokeStyle.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="duplicate">      <shortdesc>Duplicates the StripedStrokeStyle.</shortdesc>      <datatype>        <type>StripedStrokeStyle</type>      </datatype>    </method>    <method name="remove">      <shortdesc>Deletes the stroke style.</shortdesc>      <parameters>        <parameter name="replacingWith">          <shortdesc>The stroke style to apply in place of the deleted style. . Can accept: StrokeStyle or String. (Optional)</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the StripedStrokeStyle.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>StripedStrokeStyle</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>