<classdef name="ProofingType" enumeration="true">  <shortdesc>Options for proofing colors.</shortdesc>  <elements type="class">    <property name="PROOF_OFF" rwaccess="readonly">      <shortdesc>Turns off soft proof display.</shortdesc>      <datatype>        <type>number</type>        <value>1347710822</value>      </datatype>    </property>    <property name="DOCUMENT_CMYK" rwaccess="readonly">      <shortdesc>Creates a soft proof of colors using the document's CMYK profile.</shortdesc>      <datatype>        <type>number</type>        <value>1347708003</value>      </datatype>    </property>    <property name="WORKING_CMYK" rwaccess="readonly">      <shortdesc>Creates a soft proof of colors using the current CMYK working space.</shortdesc>      <datatype>        <type>number</type>        <value>1347712867</value>      </datatype>    </property>    <property name="CUSTOM" rwaccess="readonly">      <shortdesc>Allows creation of a custom proofing setup for a specific output condition.</shortdesc>      <datatype>        <type>number</type>        <value>1131639917</value>      </datatype>    </property>  </elements></classdef>