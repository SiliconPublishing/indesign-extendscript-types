<classdef name="AssignmentExportOptions" enumeration="true">  <shortdesc>Export options for assignment files.</shortdesc>  <elements type="class">    <property name="EMPTY_FRAMES" rwaccess="readonly">      <shortdesc>Exports frames but does not export content.</shortdesc>      <datatype>        <type>number</type>        <value>1098073446</value>      </datatype>    </property>    <property name="ASSIGNED_SPREADS" rwaccess="readonly">      <shortdesc>Exports only spreads with assigned frames.</shortdesc>      <datatype>        <type>number</type>        <value>1098073459</value>      </datatype>    </property>    <property name="EVERYTHING" rwaccess="readonly">      <shortdesc>Exports the entire document.</shortdesc>      <datatype>        <type>number</type>        <value>1098073441</value>      </datatype>    </property>  </elements></classdef>