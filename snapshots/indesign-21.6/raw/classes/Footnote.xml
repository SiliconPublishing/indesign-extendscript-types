<classdef name="Footnote" dynamic="true">  <shortdesc>A footnote.</shortdesc>  <elements type="instance">    <property name="allPageItems" rwaccess="readonly">      <shortdesc>Lists all page items contained by the Footnote.</shortdesc>      <datatype>        <type>PageItem</type>        <array/>      </datatype>    </property>    <property name="allGraphics" rwaccess="readonly">      <shortdesc>Lists all graphics contained by the Footnote.</shortdesc>      <datatype>        <type>Graphic</type>        <array/>      </datatype>    </property>    <property name="storyOffset" rwaccess="readonly">      <shortdesc>The location of the footnote marker in the parent story.</shortdesc>      <datatype>        <type>InsertionPoint</type>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the Footnote.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the Footnote (a Cell, Story, XmlStory, TextFrame, EndnoteTextFrame or InsertionPoint).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the Footnote within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="hiddenTexts" rwaccess="readonly">      <shortdesc>A collection of hidden text objects.</shortdesc>      <datatype>        <type>HiddenTexts</type>      </datatype>    </property>    <property name="epstexts" rwaccess="readonly">      <shortdesc>EPSTexts</shortdesc>      <datatype>        <type>EPSTexts</type>      </datatype>    </property>    <property name="pageItems" rwaccess="readonly">      <shortdesc>The page items collection, which can be used to process all page items in a container (such as a document, page, or group), regardless of type.</shortdesc>      <datatype>        <type>PageItems</type>      </datatype>    </property>    <property name="groups" rwaccess="readonly">      <shortdesc>A collection of groups.</shortdesc>      <datatype>        <type>Groups</type>      </datatype>    </property>    <property name="textColumns" rwaccess="readonly">      <shortdesc>A collection of text columns.</shortdesc>      <datatype>        <type>TextColumns</type>      </datatype>    </property>    <property name="texts" rwaccess="readonly">      <shortdesc>A collection of text objects.</shortdesc>      <datatype>        <type>Texts</type>      </datatype>    </property>    <property name="textStyleRanges" rwaccess="readonly">      <shortdesc>A collection of text style ranges.</shortdesc>      <datatype>        <type>TextStyleRanges</type>      </datatype>    </property>    <property name="paragraphs" rwaccess="readonly">      <shortdesc>A collection of paragraphs.</shortdesc>      <datatype>        <type>Paragraphs</type>      </datatype>    </property>    <property name="lines" rwaccess="readonly">      <shortdesc>A collection of lines.</shortdesc>      <datatype>        <type>Lines</type>      </datatype>    </property>    <property name="words" rwaccess="readonly">      <shortdesc>A collection of words.</shortdesc>      <datatype>        <type>Words</type>      </datatype>    </property>    <property name="characters" rwaccess="readonly">      <shortdesc>A collection of characters.</shortdesc>      <datatype>        <type>Characters</type>      </datatype>    </property>    <property name="insertionPoints" rwaccess="readonly">      <shortdesc>A collection of insertion points.</shortdesc>      <datatype>        <type>InsertionPoints</type>      </datatype>    </property>    <property name="textVariableInstances" rwaccess="readonly">      <shortdesc>A collection of text variable instances.</shortdesc>      <datatype>        <type>TextVariableInstances</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="ovals" rwaccess="readonly">      <shortdesc>A collection of ellipses.</shortdesc>      <datatype>        <type>Ovals</type>      </datatype>    </property>    <property name="splineItems" rwaccess="readonly">      <shortdesc>The spline items collection.</shortdesc>      <datatype>        <type>SplineItems</type>      </datatype>    </property>    <property name="rectangles" rwaccess="readonly">      <shortdesc>A collection of rectangles.</shortdesc>      <datatype>        <type>Rectangles</type>      </datatype>    </property>    <property name="graphicLines" rwaccess="readonly">      <shortdesc>A collection of graphic lines.</shortdesc>      <datatype>        <type>GraphicLines</type>      </datatype>    </property>    <property name="textFrames" rwaccess="readonly">      <shortdesc>A collection of text frames.</shortdesc>      <datatype>        <type>TextFrames</type>      </datatype>    </property>    <property name="polygons" rwaccess="readonly">      <shortdesc>A collection of polygons.</shortdesc>      <datatype>        <type>Polygons</type>      </datatype>    </property>    <property name="contents">      <shortdesc>The text contents of the footnote. Can return: String, SpecialCharacters enumerator or Array of Strings or SpecialCharacters enumerators. Can also accept: NothingEnum enumerator or Array of Strings, SpecialCharacters enumerators or NothingEnum enumerators.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the Footnote; this is an alias to the Footnote's label property.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the Footnote.</shortdesc>    </method>    <method name="convertToText">      <shortdesc>Converts the footnote to part of the story text and places the converted text at the former location of the footnote marker in the text.</shortdesc>      <datatype>        <type>Text</type>      </datatype>    </method>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the Footnote.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>Footnote</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>