<classdef name="TableStyleGroup" dynamic="true">  <shortdesc>A table style group.</shortdesc>  <elements type="instance">    <property name="allTableStyles" rwaccess="readonly">      <shortdesc>All Table styles</shortdesc>      <datatype>        <type>TableStyle</type>        <array/>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the TableStyleGroup.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the TableStyleGroup (a Document, Application or TableStyleGroup).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the TableStyleGroup within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="tableStyles" rwaccess="readonly">      <shortdesc>A collection of table styles.</shortdesc>      <datatype>        <type>TableStyles</type>      </datatype>    </property>    <property name="tableStyleGroups" rwaccess="readonly">      <shortdesc>A collection of table style groups.</shortdesc>      <datatype>        <type>TableStyleGroups</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the TableStyleGroup.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="duplicate">      <shortdesc>Duplicates the TableStyleGroup.</shortdesc>      <datatype>        <type>TableStyleGroup</type>      </datatype>    </method>    <method name="move">      <shortdesc>Moves the style to the specified location.</shortdesc>      <parameters>        <parameter name="to">          <shortdesc>The location relative to the reference object or within the containing object.</shortdesc>          <datatype>            <type>LocationOptions</type>          </datatype>        </parameter>        <parameter name="reference">          <shortdesc>The reference object. Note: Required when the to parameter specifies before or after. Can accept: ParagraphStyle, ParagraphStyleGroup, CharacterStyle, CharacterStyleGroup, CellStyle, CellStyleGroup, TableStyle, TableStyleGroup, Document or Application. (Optional)</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>TableStyleGroup</type>      </datatype>    </method>    <method name="remove">      <shortdesc>Deletes the style.</shortdesc>      <parameters>        <parameter name="replacingWith">          <shortdesc>The style to apply in place of the deleted style. Can accept: ParagraphStyle or CharacterStyle. (Optional)</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the TableStyleGroup.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>TableStyleGroup</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>