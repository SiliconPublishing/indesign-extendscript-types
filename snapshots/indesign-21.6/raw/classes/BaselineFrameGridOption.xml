<classdef name="BaselineFrameGridOption" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Baseline frame grid options.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the BaselineFrameGridOption (a ObjectStyle, Application, Document, TextFrame or EndnoteTextFrame).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="useCustomBaselineFrameGrid">      <shortdesc>If true, uses a custom baseline frame grid.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="startingOffsetForBaselineFrameGrid">      <shortdesc>The amount to offset the baseline grid.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>0</min>        <max>8640</max>      </datatype>    </property>    <property name="baselineFrameGridRelativeOption">      <shortdesc>The location (top of page, top margin, top of frame, or frame inset) on which to base the custom baseline grid.</shortdesc>      <datatype>        <type>BaselineFrameGridRelativeOption</type>      </datatype>    </property>    <property name="baselineFrameGridIncrement">      <shortdesc>The distance between grid lines.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>1</min>        <max>8640</max>      </datatype>    </property>    <property name="baselineFrameGridColor">      <shortdesc>The grid line color, specified either as an array of three doubles, each in the range 0 to 255 and representing R, G, and B values, or as a UI color. Can return: Array of 3 Reals (0 - 255) or UIColors enumerator.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the BaselineFrameGridOption.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>BaselineFrameGridOption</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>