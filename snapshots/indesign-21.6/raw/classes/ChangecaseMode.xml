<classdef name="ChangecaseMode" enumeration="true">  <shortdesc>Text case options.</shortdesc>  <elements type="class">    <property name="UPPERCASE" rwaccess="readonly">      <shortdesc>Makes all letters uppercase.</shortdesc>      <datatype>        <type>number</type>        <value>1667462499</value>      </datatype>    </property>    <property name="LOWERCASE" rwaccess="readonly">      <shortdesc>Makes all letters lowercase.</shortdesc>      <datatype>        <type>number</type>        <value>1667460195</value>      </datatype>    </property>    <property name="TITLECASE" rwaccess="readonly">      <shortdesc>Makes the first letter of each word uppercase.</shortdesc>      <datatype>        <type>number</type>        <value>1667462243</value>      </datatype>    </property>    <property name="SENTENCECASE" rwaccess="readonly">      <shortdesc>Makes the first letter of each sentence uppercase.</shortdesc>      <datatype>        <type>number</type>        <value>1667461987</value>      </datatype>    </property>  </elements></classdef>