<classdef name="TaskState" enumeration="true">  <shortdesc>The state of a task.</shortdesc>  <elements type="class">    <property name="QUEUED" rwaccess="readonly">      <shortdesc>Task was queued and is waiting to be scheduled for execution</shortdesc>      <datatype>        <type>number</type>        <value>1699837285</value>      </datatype>    </property>    <property name="RUNNING" rwaccess="readonly">      <shortdesc>Task is running</shortdesc>      <datatype>        <type>number</type>        <value>1700033141</value>      </datatype>    </property>    <property name="WAITING" rwaccess="readonly">      <shortdesc>Task is waiting</shortdesc>      <datatype>        <type>number</type>        <value>1700225396</value>      </datatype>    </property>    <property name="CANCELLING" rwaccess="readonly">      <shortdesc>Task was signalled to cancel but did not stop yet</shortdesc>      <datatype>        <type>number</type>        <value>1700029281</value>      </datatype>    </property>    <property name="COMPLETED" rwaccess="readonly">      <shortdesc>Task completed execution (successfully or with errors)</shortdesc>      <datatype>        <type>number</type>        <value>1700029296</value>      </datatype>    </property>    <property name="CANCELLED" rwaccess="readonly">      <shortdesc>Task was cancelled (either before it ran or during execution</shortdesc>      <datatype>        <type>number</type>        <value>1700029292</value>      </datatype>    </property>  </elements></classdef>