<classdef name="Menu" dynamic="true">  <shortdesc>A menu.</shortdesc>  <elements type="class">    <property name="BEFORE_DISPLAY" rwaccess="readonly">      <shortdesc>Dispatched before the Menu is displayed. This event does not bubble. This event is not cancelable.</shortdesc>      <datatype>        <type>string</type>        <value>beforeDisplay</value>      </datatype>    </property>  </elements>  <elements type="instance">    <property name="name" rwaccess="readonly">      <shortdesc>The name of the Menu.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="title" rwaccess="readonly">      <shortdesc>The name of the Menu for display in the user interface. The title includes any ampersand characters (&amp;), which are used to tell the Windows OS to underline the following character in the name for use with the Alt key to navigate to a menu item. Double ampersands are used to display an actual ampersand character in the name. The Mac OS ignores and removes the extra ampersand characters.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the Menu (a Application).</shortdesc>      <datatype>        <type>Application</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the Menu within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="menuElements" rwaccess="readonly">      <shortdesc>A collection of menu elements.</shortdesc>      <datatype>        <type>MenuElements</type>      </datatype>    </property>    <property name="submenus" rwaccess="readonly">      <shortdesc>A collection of submenus.</shortdesc>      <datatype>        <type>Submenus</type>      </datatype>    </property>    <property name="menuItems" rwaccess="readonly">      <shortdesc>A collection of menu items.</shortdesc>      <datatype>        <type>MenuItems</type>      </datatype>    </property>    <property name="menuSeparators" rwaccess="readonly">      <shortdesc>A collection of menu separators.</shortdesc>      <datatype>        <type>MenuSeparators</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the Menu.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>Menu</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>