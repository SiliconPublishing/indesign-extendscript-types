<classdef name="OTFFigureStyle" enumeration="true">  <shortdesc>Figure style options for OpenType fonts.</shortdesc>  <elements type="class">    <property name="TABULAR_LINING" rwaccess="readonly">      <shortdesc>Use monspaced lining figures.</shortdesc>      <datatype>        <type>number</type>        <value>1330931316</value>      </datatype>    </property>    <property name="PROPORTIONAL_OLDSTYLE" rwaccess="readonly">      <shortdesc>Use proportional width oldstyle figures.</shortdesc>      <datatype>        <type>number</type>        <value>1330933619</value>      </datatype>    </property>    <property name="PROPORTIONAL_LINING" rwaccess="readonly">      <shortdesc>Use proportional width lining figures.</shortdesc>      <datatype>        <type>number</type>        <value>1330932848</value>      </datatype>    </property>    <property name="TABULAR_OLDSTYLE" rwaccess="readonly">      <shortdesc>Use monospaced oldstyle figures.</shortdesc>      <datatype>        <type>number</type>        <value>1330933620</value>      </datatype>    </property>    <property name="DEFAULT_VALUE" rwaccess="readonly">      <shortdesc>Use the default figure style for the font.</shortdesc>      <datatype>        <type>number</type>        <value>1147563124</value>      </datatype>    </property>  </elements></classdef>