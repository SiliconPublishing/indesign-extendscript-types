<classdef name="EPubFixedLayoutExportPreference" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>EPub fixed layout export preferences.</shortdesc>  <elements type="instance">    <property name="level" rwaccess="readonly">      <shortdesc>The PNG compression level.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the EPubFixedLayoutExportPreference (a Book or Document).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="epubPublisher">      <shortdesc>The epub publisher.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="id">      <shortdesc>The epub unique identifier, like ISBN.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubCover">      <shortdesc>The epub cover option.</shortdesc>      <datatype>        <type>EpubCover</type>      </datatype>    </property>    <property name="coverImageFile">      <shortdesc>The epub cover image file path.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="imageExportResolution">      <shortdesc>The export resolution</shortdesc>      <datatype>        <type>ImageResolution</type>      </datatype>    </property>    <property name="imageConversion">      <shortdesc>The file format to use for converted images. Note: Valid only when copy optimized images and/or copy formatted images is true.</shortdesc>      <datatype>        <type>ImageConversion</type>      </datatype>    </property>    <property name="gifOptionsPalette">      <shortdesc>The color palette for GIF conversion. Note: Not valid when image conversion is JPEG.</shortdesc>      <datatype>        <type>GIFOptionsPalette</type>      </datatype>    </property>    <property name="gifOptionsInterlaced">      <shortdesc>If true, generates interlaced GIFs. Note: Not valid  when image conversion is JPEG.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="jpegOptionsQuality">      <shortdesc>The quality of converted JPEG images. Note: Not valid when image conversion is GIF.</shortdesc>      <datatype>        <type>JPEGOptionsQuality</type>      </datatype>    </property>    <property name="jpegOptionsFormat">      <shortdesc>The formatting method for converted JPEG images. Note: Not valid  when image conversion is GIF.</shortdesc>      <datatype>        <type>JPEGOptionsFormat</type>      </datatype>    </property>    <property name="tocStyleName">      <shortdesc>The name of TOC style to generate epub TOC.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="externalStyleSheets">      <shortdesc>The file path of external cascading style sheets.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="javascripts">      <shortdesc>The file path of external javascripts.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="epubTitle">      <shortdesc>The epub title.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubCreator">      <shortdesc>The epub creator.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubSubject">      <shortdesc>The epub subject.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubDescription">      <shortdesc>The epub description.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubDate">      <shortdesc>The epub date.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubRights">      <shortdesc>The epub rights.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubPageRange">      <shortdesc>The epub page range.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubPageRangeFormat">      <shortdesc>The epub page range format.</shortdesc>      <datatype>        <type>PageRangeFormat</type>      </datatype>    </property>    <property name="epubSpreadControlOptions">      <shortdesc>The control for spreads in fixed layout EPub.</shortdesc>      <datatype>        <type>EpubFixedLayoutSpreadControl</type>      </datatype>    </property>    <property name="epubNavigationStyles">      <shortdesc>The epub navigation style.</shortdesc>      <datatype>        <type>EpubNavigationStyle</type>      </datatype>    </property>    <property name="epubAccessibilityFeature">      <shortdesc>The epub accessibility feature.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityHazard">      <shortdesc>The epub accessibility hazard.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityMode">      <shortdesc>The epub accessibility mode.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityModeSufficient">      <shortdesc>The epub accessibility mode sufficient.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilitySummary">      <shortdesc>The epub accessibility summary.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityConformsTo">      <shortdesc>The epub accessibility conforms to.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityCertifiedBy">      <shortdesc>The epub accessibility certified by.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityCredentials">      <shortdesc>The epub accessibility credentials.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityReportLink">      <shortdesc>The epub accessibility report link.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the EPubFixedLayoutExportPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>EPubFixedLayoutExportPreference</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>