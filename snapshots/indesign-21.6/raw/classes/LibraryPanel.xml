<classdef name="LibraryPanel" dynamic="true">  <superclass href="#/Panel">Panel</superclass>  <shortdesc>Library panel</shortdesc>  <elements type="instance">    <property name="associatedLibrary" rwaccess="readonly">      <shortdesc>The library displayed in this LibraryPanel</shortdesc>      <datatype>        <type>Library</type>      </datatype>    </property>    <property name="name" rwaccess="readonly">      <shortdesc>The name of the LibraryPanel.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the LibraryPanel (a Application).</shortdesc>      <datatype>        <type>Application</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the LibraryPanel within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="view">      <shortdesc>LibraryPanel view</shortdesc>      <datatype>        <type>LibraryPanelViews</type>      </datatype>    </property>    <property name="sortOrder">      <shortdesc>The sort order of the assets in the LibraryPanel</shortdesc>      <datatype>        <type>SortAssets</type>      </datatype>    </property>    <property name="selection">      <shortdesc>The selected object(s). Can also accept: Object or NothingEnum enumerator.</shortdesc>      <datatype>        <type>Object</type>        <array/>      </datatype>    </property>    <property name="visible">      <shortdesc>If true, the panel is visible.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="showAll">      <shortdesc>Show all assets</shortdesc>    </method>    <method name="select">      <shortdesc>Selects the specified object(s).</shortdesc>      <parameters>        <parameter name="selectableItems">          <shortdesc>The objects to select. Can accept: Object, Array of Objects, NothingEnum enumerator or SelectAll enumerator.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="existingSelection" optional="true">          <shortdesc>The selection status of the LibraryPanel in relation to previously selected objects. (Optional)</shortdesc>          <datatype>            <type>SelectionOptions</type>            <value>SelectionOptions.REPLACE_WITH</value>          </datatype>        </parameter>      </parameters>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the LibraryPanel.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>LibraryPanel</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>