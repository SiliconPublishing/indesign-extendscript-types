<classdef name="DocumentPrintUiOptions" enumeration="true">  <shortdesc>Document print ui options</shortdesc>  <elements type="class">    <property name="SUPPRESS_PRINT_PROGRESS" rwaccess="readonly">      <shortdesc>Do not show progress bar during printing.</shortdesc>      <datatype>        <type>number</type>        <value>1936748659</value>      </datatype>    </property>    <property name="SUPPRESS_PRINT_WARNINGS" rwaccess="readonly">      <shortdesc>Do not show warning dialog during printing.</shortdesc>      <datatype>        <type>number</type>        <value>1936750450</value>      </datatype>    </property>    <property name="SUPPRESS_PRINT_DIALOG" rwaccess="readonly">      <shortdesc>Do not show print dialog.</shortdesc>      <datatype>        <type>number</type>        <value>1936745575</value>      </datatype>    </property>    <property name="SUPPRESS_FILE_SAVE_DIALOG" rwaccess="readonly">      <shortdesc>Do not show file save dialog during printing.</shortdesc>      <datatype>        <type>number</type>        <value>1936089444</value>      </datatype>    </property>  </elements></classdef>