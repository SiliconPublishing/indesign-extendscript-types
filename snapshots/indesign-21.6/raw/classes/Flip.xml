<classdef name="Flip" enumeration="true">  <shortdesc>Flip direction options.</shortdesc>  <elements type="class">    <property name="NONE" rwaccess="readonly">      <shortdesc>The printed image is not flipped.</shortdesc>      <datatype>        <type>number</type>        <value>1852796517</value>      </datatype>    </property>    <property name="HORIZONTAL" rwaccess="readonly">      <shortdesc>Flips the printed image horizontally.</shortdesc>      <datatype>        <type>number</type>        <value>1752134266</value>      </datatype>    </property>    <property name="VERTICAL" rwaccess="readonly">      <shortdesc>Flips the printed image vertically.</shortdesc>      <datatype>        <type>number</type>        <value>1986359924</value>      </datatype>    </property>    <property name="HORIZONTAL_AND_VERTICAL" rwaccess="readonly">      <shortdesc>Flips the printed image horizontally and vertically (same as rotate 180).</shortdesc>      <datatype>        <type>number</type>        <value>1215977068</value>      </datatype>    </property>    <property name="BOTH" rwaccess="readonly">      <shortdesc>Horizontal and vertical flip (same as rotate 180)</shortdesc>      <datatype>        <type>number</type>        <value>1651471464</value>      </datatype>    </property>  </elements></classdef>