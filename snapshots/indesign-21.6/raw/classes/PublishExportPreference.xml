<classdef name="PublishExportPreference" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Publish export preferences.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the PublishExportPreference (a Document).</shortdesc>      <datatype>        <type>Document</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="publishCover">      <shortdesc>The publish cover option.</shortdesc>      <datatype>        <type>PublishCoverEnum</type>      </datatype>    </property>    <property name="coverImageFile">      <shortdesc>The epub cover image file path.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="publishPageRange">      <shortdesc>The publish page range.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="publishPageRangeFormat">      <shortdesc>The publish page range format.</shortdesc>      <datatype>        <type>PageRangeFormat</type>      </datatype>    </property>    <property name="imageConversion">      <shortdesc>The file format to use for converted images. Note: Valid only when copy optimized images and/or copy formatted images is true.</shortdesc>      <datatype>        <type>ImageConversion</type>      </datatype>    </property>    <property name="imageExportResolution">      <shortdesc>The export resolution</shortdesc>      <datatype>        <type>ImageResolution</type>      </datatype>    </property>    <property name="publishDescription">      <shortdesc>The publish description.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="publishFileName">      <shortdesc>The file name.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="publishFormat">      <shortdesc>the publish format.</shortdesc>      <datatype>        <type>PublishFormatEnum</type>      </datatype>    </property>    <property name="coverPage">      <shortdesc>The cover page.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="gifOptionsPalette">      <shortdesc>The color palette for GIF conversion. Note: Not valid when image conversion is JPEG.</shortdesc>      <datatype>        <type>GIFOptionsPalette</type>      </datatype>    </property>    <property name="jpegOptionsQuality">      <shortdesc>The quality of converted JPEG images. Note: Not valid when image conversion is GIF.</shortdesc>      <datatype>        <type>JPEGOptionsQuality</type>      </datatype>    </property>    <property name="publishPdf">      <shortdesc>If PDF should be uploaded while publishing.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the PublishExportPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>PublishExportPreference</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>