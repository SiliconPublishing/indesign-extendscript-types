<classdef name="TransformationMatrix" dynamic="true">  <shortdesc>A transformation matrix.</shortdesc>  <elements type="instance">    <property name="name" rwaccess="readonly">      <shortdesc>The name of the TransformationMatrix.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="matrixValues" rwaccess="readonly">      <shortdesc>The values of the transformation matrix.</shortdesc>      <datatype>        <type>number</type>        <array/>      </datatype>    </property>    <property name="horizontalScaleFactor" rwaccess="readonly">      <shortdesc>The horizontal scale factor of the transformation matrix.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="verticalScaleFactor" rwaccess="readonly">      <shortdesc>The vertical scale factor of the transformation matrix.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="clockwiseShearAngle" rwaccess="readonly">      <shortdesc>The shear angle of the transformation matrix.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="counterclockwiseRotationAngle" rwaccess="readonly">      <shortdesc>The rotation angle of the transformation matrix.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="horizontalTranslation" rwaccess="readonly">      <shortdesc>The horizontal translation of the transformation matrix.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="verticalTranslation" rwaccess="readonly">      <shortdesc>The vertical translation of the transformation matrix.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="matrixMapping" rwaccess="readonly">      <shortdesc>The mapping the transformation matrix performs on the unit triangle. Can return: Array of Array of 2 Arrays of 2 Reals.</shortdesc>      <datatype>        <type>varies=any</type>        <array/>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the TransformationMatrix (a Application).</shortdesc>      <datatype>        <type>Application</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the TransformationMatrix within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="scaleMatrix">      <shortdesc>Scale the transformation matrix.</shortdesc>      <parameters>        <parameter name="horizontallyBy">          <shortdesc>The horizontal scale factor (Optional)</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>        <parameter name="verticallyBy">          <shortdesc>The vertical scale factor (Optional)</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>TransformationMatrix</type>      </datatype>    </method>    <method name="shearMatrix">      <shortdesc>Shear the transformation matrix.</shortdesc>      <parameters>        <parameter name="byAngle">          <shortdesc>The horizontal shear angle (Optional)</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>        <parameter name="bySlope">          <shortdesc>The horizontal shear slope (Optional)</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>TransformationMatrix</type>      </datatype>    </method>    <method name="rotateMatrix">      <shortdesc>Rotate the transformation matrix.</shortdesc>      <parameters>        <parameter name="byAngle">          <shortdesc>The counterclockwise rotation angle (Optional)</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>        <parameter name="byCosine">          <shortdesc>The cosine of the desired rotation (Optional)</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>        <parameter name="bySine">          <shortdesc>The sine of the desired rotation (Optional)</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>TransformationMatrix</type>      </datatype>    </method>    <method name="translateMatrix">      <shortdesc>Translate the transformation matrix.</shortdesc>      <parameters>        <parameter name="horizontallyBy">          <shortdesc>The horizontal translation distance (Optional)</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>        <parameter name="verticallyBy">          <shortdesc>The vertical translation distance (Optional)</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>TransformationMatrix</type>      </datatype>    </method>    <method name="catenateMatrix">      <shortdesc>Multiply the transformation matrix by another.</shortdesc>      <parameters>        <parameter name="withMatrix">          <shortdesc>The right hand matrix factor</shortdesc>          <datatype>            <type>TransformationMatrix</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>TransformationMatrix</type>      </datatype>    </method>    <method name="invertMatrix">      <shortdesc>Invert the transformation matrix.</shortdesc>      <datatype>        <type>TransformationMatrix</type>      </datatype>    </method>    <method name="changeCoordinates">      <shortdesc>Multiply the point by the matrix.</shortdesc>      <parameters>        <parameter name="point">          <shortdesc>The point to transform</shortdesc>          <datatype>            <type>number</type>            <array/>          </datatype>        </parameter>      </parameters>      <datatype>        <type>number</type>        <array/>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the TransformationMatrix.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>TransformationMatrix</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>