<classdef name="AnchoredObjectDefault" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Anchored object default settings.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the AnchoredObjectDefault (a Application or Document).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="anchorContent">      <shortdesc>The initial frame type of a new anchored object.</shortdesc>      <datatype>        <type>ContentType</type>      </datatype>    </property>    <property name="initialAnchorHeight">      <shortdesc>The initial height of a new anchored object.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="initialAnchorWidth">      <shortdesc>The initial width of a new anchored object.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="anchoredParagraphStyle">      <shortdesc>The initial paragraph style of a new anchored object. Note: Valid when anchor content is text.</shortdesc>      <datatype>        <type>ParagraphStyle</type>      </datatype>    </property>    <property name="anchoredObjectStyle">      <shortdesc>The initial object style of a new anchored object.</shortdesc>      <datatype>        <type>ObjectStyle</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the AnchoredObjectDefault.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>AnchoredObjectDefault</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>