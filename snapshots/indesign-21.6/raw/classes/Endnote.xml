<classdef name="Endnote" dynamic="true">  <shortdesc>An endnote.</shortdesc>  <elements type="instance">    <property name="storyOffset" rwaccess="readonly">      <shortdesc>The location of the endnote marker in the parent story</shortdesc>      <datatype>        <type>InsertionPoint</type>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the Endnote.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the Endnote (a InsertionPoint, Story, XmlStory, Cell or Table).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the Endnote within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="textColumns" rwaccess="readonly">      <shortdesc>A collection of text columns.</shortdesc>      <datatype>        <type>TextColumns</type>      </datatype>    </property>    <property name="texts" rwaccess="readonly">      <shortdesc>A collection of text objects.</shortdesc>      <datatype>        <type>Texts</type>      </datatype>    </property>    <property name="textStyleRanges" rwaccess="readonly">      <shortdesc>A collection of text style ranges.</shortdesc>      <datatype>        <type>TextStyleRanges</type>      </datatype>    </property>    <property name="lines" rwaccess="readonly">      <shortdesc>A collection of lines.</shortdesc>      <datatype>        <type>Lines</type>      </datatype>    </property>    <property name="words" rwaccess="readonly">      <shortdesc>A collection of words.</shortdesc>      <datatype>        <type>Words</type>      </datatype>    </property>    <property name="characters" rwaccess="readonly">      <shortdesc>A collection of characters.</shortdesc>      <datatype>        <type>Characters</type>      </datatype>    </property>    <property name="insertionPoints" rwaccess="readonly">      <shortdesc>A collection of insertion points.</shortdesc>      <datatype>        <type>InsertionPoints</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="endnoteTextRange">      <shortdesc>The endnote range object.</shortdesc>      <datatype>        <type>EndnoteRange</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the Endnote; this is an alias to the Endnote's label property.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="deleteEndnote">      <shortdesc>Deletes the endnote reference and the associated endnote text range.</shortdesc>    </method>    <method name="insertTextInEndnote">      <shortdesc>Insert the text in endnote text range at specified text index. Insertion position should lie within the start and end range indices excluding the markers</shortdesc>      <parameters>        <parameter name="storyOffset">          <shortdesc>The location within the story, specified as an insertion point.</shortdesc>          <datatype>            <type>InsertionPoint</type>          </datatype>        </parameter>        <parameter name="contents">          <shortdesc>The content to insert.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the Endnote.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>Endnote</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>