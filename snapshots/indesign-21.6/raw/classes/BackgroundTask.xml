<classdef name="BackgroundTask" dynamic="true">  <shortdesc>background task</shortdesc>  <elements type="instance">    <property name="name" rwaccess="readonly">      <shortdesc>The name of the BackgroundTask.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="documentName" rwaccess="readonly">      <shortdesc>The document name on which this task operates.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="percentDone" rwaccess="readonly">      <shortdesc>Progress information for this task.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="status" rwaccess="readonly">      <shortdesc>The current status of this task object.</shortdesc>      <datatype>        <type>TaskState</type>      </datatype>    </property>    <property name="alerts" rwaccess="readonly">      <shortdesc>The alerts encountered while running this task object. Can return: Array of Array of 2 TaskAlertType enumerators or Strings.</shortdesc>      <datatype>        <type>varies=any</type>        <array/>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the BackgroundTask.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the BackgroundTask (a Application).</shortdesc>      <datatype>        <type>Application</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the BackgroundTask within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="cancelTask">      <shortdesc>Cancels the specified background task.</shortdesc>    </method>    <method name="waitForTask">      <shortdesc>Waits for the task to finish.</shortdesc>      <datatype>        <type>TaskState</type>      </datatype>    </method>    <method name="queryProperty">      <shortdesc>Queries for a particular property in the task metadata.</shortdesc>      <parameters>        <parameter name="name">          <shortdesc>The task property being queried</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>any</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the BackgroundTask.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>BackgroundTask</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>