<classdef name="UserDictionary" dynamic="true">  <shortdesc>A user dictionary.</shortdesc>  <elements type="instance">    <property name="name" rwaccess="readonly">      <shortdesc>The name of the UserDictionary.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the UserDictionary (a Application).</shortdesc>      <datatype>        <type>Application</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the UserDictionary within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="addedWords">      <shortdesc>A list of words added to the user dictionary.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="removedWords">      <shortdesc>A list of words removed from the user dictionary.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="addWord">      <shortdesc>Adds the specified words to the specified list in the dictionary.</shortdesc>      <parameters>        <parameter name="addedWords">          <shortdesc>The words to add.</shortdesc>          <datatype>            <type>string</type>            <array/>          </datatype>        </parameter>        <parameter name="removedList" optional="true">          <shortdesc>If true, adds the words to the removed words list. If false or unspecified, adds the words to the added words list. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>    </method>    <method name="removeWord">      <shortdesc>Removes the specified words from the specified list in the dictionary.</shortdesc>      <parameters>        <parameter name="removedWords">          <shortdesc>The words to remove.</shortdesc>          <datatype>            <type>string</type>            <array/>          </datatype>        </parameter>        <parameter name="removedList" optional="true">          <shortdesc>If true, removes the words from the removed words list. If false or unspecified, removes the words from the added words list. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the UserDictionary.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>UserDictionary</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>