<classdef name="NavigationPoint" dynamic="true">  <shortdesc>A navigation point.</shortdesc>  <elements type="instance">    <property name="id" rwaccess="readonly">      <shortdesc>Unique internally-generated identifier (read only).</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the NavigationPoint (a Movie).</shortdesc>      <datatype>        <type>Movie</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the NavigationPoint within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="name">      <shortdesc>The UI display name.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="time">      <shortdesc>The time in seconds rounded up to two decimal places (e.g., 3.115 rounded to 3.12).</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the NavigationPoint.</shortdesc>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the NavigationPoint.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>NavigationPoint</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>