<classdef name="ExcelImportPreference" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Excel import preferences.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the ExcelImportPreference (a Application).</shortdesc>      <datatype>        <type>Application</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="viewName">      <shortdesc>The stored custom or personal view(s) to import with the file.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="sheetName">      <shortdesc>The worksheet to import.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="sheetIndex">      <shortdesc>The worksheet's index. For information, see sheet name.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="rangeName">      <shortdesc>The range of cells to import. Note: Use a colon (:) to separate the start and end cell names in the range.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="alignmentStyle">      <shortdesc>The cell alignment for the imported document.</shortdesc>      <datatype>        <type>AlignmentStyleOptions</type>      </datatype>    </property>    <property name="decimalPlaces">      <shortdesc>The number of decimal places to include. Note: Valid only when alignment style is decimal.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="showHiddenCells">      <shortdesc>If true, shows hidden cells.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="errorCode">      <shortdesc>The import error code. (Key: 0=Success; 1=Empty Sheet; 2=Invalid sheet; 3=Invalid range; 4=Invalid View; 5=Misc. Error)</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="tableFormatting">      <shortdesc>The format for imported spreadsheets.</shortdesc>      <datatype>        <type>TableFormattingOptions</type>      </datatype>    </property>    <property name="useTypographersQuotes">      <shortdesc>If true, convert straight quotes and apostrophes in the imported text to typographic quotation marks and apostrophes.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="preserveGraphics">      <shortdesc>If true, preserves inline graphics.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the ExcelImportPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>ExcelImportPreference</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>