<classdef name="BorderPanel" dynamic="true">  <superclass href="#/Widget">Widget</superclass>  <shortdesc>A bordered panel on a dialog that can contain any type and number of controls.</shortdesc>  <elements type="instance">    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the BorderPanel.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the BorderPanel (a DialogColumn, DialogRow, EnablingGroup or BorderPanel).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the BorderPanel within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="dialogColumns" rwaccess="readonly">      <shortdesc>A collection of dialog columns.</shortdesc>      <datatype>        <type>DialogColumns</type>      </datatype>    </property>    <property name="widgets" rwaccess="readonly">      <shortdesc>A collection of widgets.</shortdesc>      <datatype>        <type>Widgets</type>      </datatype>    </property>    <property name="textEditboxes" rwaccess="readonly">      <shortdesc>A collection of text editboxes.</shortdesc>      <datatype>        <type>TextEditboxes</type>      </datatype>    </property>    <property name="integerEditboxes" rwaccess="readonly">      <shortdesc>A collection of integer editboxes.</shortdesc>      <datatype>        <type>IntegerEditboxes</type>      </datatype>    </property>    <property name="measurementEditboxes" rwaccess="readonly">      <shortdesc>A collection of measurement editboxes.</shortdesc>      <datatype>        <type>MeasurementEditboxes</type>      </datatype>    </property>    <property name="realEditboxes" rwaccess="readonly">      <shortdesc>A collection of real number editboxes.</shortdesc>      <datatype>        <type>RealEditboxes</type>      </datatype>    </property>    <property name="angleEditboxes" rwaccess="readonly">      <shortdesc>A collection of angle editboxes.</shortdesc>      <datatype>        <type>AngleEditboxes</type>      </datatype>    </property>    <property name="percentEditboxes" rwaccess="readonly">      <shortdesc>A collection of percent editboxes.</shortdesc>      <datatype>        <type>PercentEditboxes</type>      </datatype>    </property>    <property name="integerComboboxes" rwaccess="readonly">      <shortdesc>A collection of integer comboboxes.</shortdesc>      <datatype>        <type>IntegerComboboxes</type>      </datatype>    </property>    <property name="measurementComboboxes" rwaccess="readonly">      <shortdesc>A collection of measurement comboboxes.</shortdesc>      <datatype>        <type>MeasurementComboboxes</type>      </datatype>    </property>    <property name="realComboboxes" rwaccess="readonly">      <shortdesc>A collection of real number comboboxes.</shortdesc>      <datatype>        <type>RealComboboxes</type>      </datatype>    </property>    <property name="angleComboboxes" rwaccess="readonly">      <shortdesc>A collection of angle comboboxes.</shortdesc>      <datatype>        <type>AngleComboboxes</type>      </datatype>    </property>    <property name="percentComboboxes" rwaccess="readonly">      <shortdesc>A collection of percent comboboxes.</shortdesc>      <datatype>        <type>PercentComboboxes</type>      </datatype>    </property>    <property name="checkboxControls" rwaccess="readonly">      <shortdesc>A collection of checkbox controls.</shortdesc>      <datatype>        <type>CheckboxControls</type>      </datatype>    </property>    <property name="staticTexts" rwaccess="readonly">      <shortdesc>A collection of static text objects.</shortdesc>      <datatype>        <type>StaticTexts</type>      </datatype>    </property>    <property name="dropdowns" rwaccess="readonly">      <shortdesc>A collection of dropdowns.</shortdesc>      <datatype>        <type>Dropdowns</type>      </datatype>    </property>    <property name="borderPanels" rwaccess="readonly">      <shortdesc>A collection of border panels.</shortdesc>      <datatype>        <type>BorderPanels</type>      </datatype>    </property>    <property name="enablingGroups" rwaccess="readonly">      <shortdesc>A collection of enabling groups.</shortdesc>      <datatype>        <type>EnablingGroups</type>      </datatype>    </property>    <property name="radiobuttonGroups" rwaccess="readonly">      <shortdesc>A collection of radiobutton groups.</shortdesc>      <datatype>        <type>RadiobuttonGroups</type>      </datatype>    </property>    <property name="minWidth">      <shortdesc>The width of the control. For an editbox or combobox, specifies the minimum width of the box.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the BorderPanel.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>BorderPanel</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>