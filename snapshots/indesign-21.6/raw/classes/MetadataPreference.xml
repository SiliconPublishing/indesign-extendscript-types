<classdef name="MetadataPreference" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Metadata preferences.</shortdesc>  <elements type="instance">    <property name="serverURL" rwaccess="readonly">      <shortdesc>The location of the document on the asset management server.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="modificationDate" rwaccess="readonly">      <shortdesc>The most recent modification date of the document.</shortdesc>      <datatype>        <type>Date</type>      </datatype>    </property>    <property name="creationDate" rwaccess="readonly">      <shortdesc>The creation date of the document.</shortdesc>      <datatype>        <type>Date</type>      </datatype>    </property>    <property name="creator" rwaccess="readonly">      <shortdesc>The name of the application used to create the document.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="format" rwaccess="readonly">      <shortdesc>The format of the document.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the MetadataPreference (a Document).</shortdesc>      <datatype>        <type>Document</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="author">      <shortdesc>The author of the document.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="description">      <shortdesc>The description of the MetadataPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="jobName">      <shortdesc>The job name.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="copyrightStatus">      <shortdesc>The copyright status of the document.</shortdesc>      <datatype>        <type>CopyrightStatus</type>      </datatype>    </property>    <property name="copyrightNotice">      <shortdesc>The text to use as a copyright notice.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="copyrightInfoURL">      <shortdesc>The URL of the file that contains the linked copyright statement.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="keywords">      <shortdesc>The list of keywords associated with the document.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="documentTitle">      <shortdesc>The title of the document.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="save">      <shortdesc>Saves the metadata in the document to an external file.</shortdesc>      <parameters>        <parameter name="to">          <shortdesc>The path to the external file.</shortdesc>          <datatype>            <type>File</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="replace">      <shortdesc>Replaces the current metadata in the document with metadata from the specified file.</shortdesc>      <parameters>        <parameter name="using">          <shortdesc>The full path to the file that contains the replacement metadata.</shortdesc>          <datatype>            <type>File</type>          </datatype>        </parameter>        <parameter name="affectAll" optional="true">          <shortdesc>If true, treats all properties as external. Note: Defaults to false. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>    </method>    <method name="append">      <shortdesc>Uses metadata from the specified external file to define any undefined metadata properties in the document.</shortdesc>      <parameters>        <parameter name="from">          <shortdesc>The path to the external file that contains the metadata.</shortdesc>          <datatype>            <type>File</type>          </datatype>        </parameter>        <parameter name="affectAll" optional="true">          <shortdesc>If true, also replaces existing metadata with data from the external file. If false, does not replace existing metadata. Note: Defaults to false. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>    </method>    <method name="getProperty">      <shortdesc>Gets the XMP property value associated with the specified path.</shortdesc>      <parameters>        <parameter name="namespace">          <shortdesc>The namespace of the property.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="path">          <shortdesc>The specified path.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="setProperty">      <shortdesc>Sets the XMP property associated with the specified path.</shortdesc>      <parameters>        <parameter name="namespace">          <shortdesc>The namespace of the property.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="path">          <shortdesc>The specified path(s).</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value to assign to the property. Note: To remove the property, pass an empty string.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="createContainerItem">      <shortdesc>Creates an empty container.</shortdesc>      <parameters>        <parameter name="namespace">          <shortdesc>The namespace of the container.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="path">          <shortdesc>The path to the container.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="index" optional="true">          <shortdesc>The index of the item within the container. Specified values must be 1 or greater. To append the item to the end of the index and allow the next available value to be assigned, use 0. (Optional)</shortdesc>          <datatype>            <type>number</type>            <value>0</value>          </datatype>        </parameter>        <parameter name="container" optional="true">          <shortdesc>The container type. Note: Required when the new item is the first item added to the container. (Optional)</shortdesc>          <datatype>            <type>ContainerType</type>            <value>ContainerType.BAG</value>          </datatype>        </parameter>      </parameters>    </method>    <method name="countContainer">      <shortdesc>Counts the number of items in the container.</shortdesc>      <parameters>        <parameter name="namespace">          <shortdesc>The namespace of the container.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="path">          <shortdesc>The path to the container.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>number</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the MetadataPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>MetadataPreference</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>