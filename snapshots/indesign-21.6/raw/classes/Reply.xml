<classdef name="Reply" dynamic="true">  <shortdesc>Reply object.</shortdesc>  <elements type="instance">    <property name="replyReviewer" rwaccess="readonly">      <shortdesc>The name of the reviewer who made the reply</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="replyContent" rwaccess="readonly">      <shortdesc>The content of the reply</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="replyDate" rwaccess="readonly">      <shortdesc>The date of the reply</shortdesc>      <datatype>        <type>Date</type>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the Reply.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the Reply (a PDFComment).</shortdesc>      <datatype>        <type>PDFComment</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the Reply within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the Reply; this is an alias to the Reply's label property.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the Reply.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>Reply</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>