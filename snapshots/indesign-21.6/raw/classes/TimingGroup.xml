<classdef name="TimingGroup" dynamic="true">  <shortdesc>a timing group.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the TimingGroup (a TimingList).</shortdesc>      <datatype>        <type>TimingList</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the TimingGroup within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="timingTargets" rwaccess="readonly">      <shortdesc>A collection of timing target.</shortdesc>      <datatype>        <type>TimingTargets</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="placement">      <shortdesc>The placement of the timing group in the timing list.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="plays">      <shortdesc>The number of times this timing group plays.</shortdesc>      <datatype>        <type>number</type>        <min>1</min>        <max>100</max>      </datatype>    </property>    <property name="playsLoop">      <shortdesc>Set to true if timing group loops.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the TimingGroup.</shortdesc>    </method>    <method name="unlink">      <shortdesc>Unlink all targets in the group into separate groups in this timing list.</shortdesc>    </method>    <method name="move">      <shortdesc>Moves the timing group or target to the specified location.</shortdesc>      <parameters>        <parameter name="to">          <shortdesc>The location in relation to the reference object or within the containing object.</shortdesc>          <datatype>            <type>LocationOptions</type>          </datatype>        </parameter>        <parameter name="reference">          <shortdesc>The reference object. Note: Required when the to parameter specifies before or after. . Can accept: TimingGroup, TimingTarget or TimingList. (Optional)</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>TimingGroup</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the TimingGroup.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>TimingGroup</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>