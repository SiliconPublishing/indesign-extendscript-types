<classdef name="BalanceLinesStyle" enumeration="true">  <shortdesc>Options for balancing line endings in the text.</shortdesc>  <elements type="class">    <property name="NO_BALANCING" rwaccess="readonly">      <shortdesc>Does not balance lines.</shortdesc>      <datatype>        <type>number</type>        <value>1114394470</value>      </datatype>    </property>    <property name="VEE_SHAPE" rwaccess="readonly">      <shortdesc>Prefers shorter last lines.</shortdesc>      <datatype>        <type>number</type>        <value>1114396261</value>      </datatype>    </property>    <property name="FULLY_BALANCED" rwaccess="readonly">      <shortdesc>Balances lines equally.</shortdesc>      <datatype>        <type>number</type>        <value>1114391921</value>      </datatype>    </property>    <property name="PYRAMID_SHAPE" rwaccess="readonly">      <shortdesc>Prefers longer last lines.</shortdesc>      <datatype>        <type>number</type>        <value>1114394745</value>      </datatype>    </property>  </elements></classdef>