<classdef name="HyperlinkAppearanceHighlight" enumeration="true">  <shortdesc>Options for highlighting the hyperlink when selected.</shortdesc>  <elements type="class">    <property name="NONE" rwaccess="readonly">      <shortdesc>Does not highlight the hyperlink.</shortdesc>      <datatype>        <type>number</type>        <value>1852796517</value>      </datatype>    </property>    <property name="INVERT" rwaccess="readonly">      <shortdesc>Highlights the hyperlink fill color.</shortdesc>      <datatype>        <type>number</type>        <value>1853256308</value>      </datatype>    </property>    <property name="OUTLINE" rwaccess="readonly">      <shortdesc>Highlights the hyperlink border.</shortdesc>      <datatype>        <type>number</type>        <value>1869900910</value>      </datatype>    </property>    <property name="INSET" rwaccess="readonly">      <shortdesc>Highlights the hyperlink border inset.</shortdesc>      <datatype>        <type>number</type>        <value>1853056372</value>      </datatype>    </property>  </elements></classdef>