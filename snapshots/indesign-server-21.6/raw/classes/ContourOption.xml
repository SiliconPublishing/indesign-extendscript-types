<classdef name="ContourOption" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>A contour option.</shortdesc>  <elements type="instance">    <property name="photoshopPathNames" rwaccess="readonly">      <shortdesc>A list of the clipping paths stored in the graphic.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="alphaChannelPathNames" rwaccess="readonly">      <shortdesc>A list of the alpha channels stored in the graphic.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the ContourOption (a TextWrapPreference).</shortdesc>      <datatype>        <type>TextWrapPreference</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="contourType">      <shortdesc>The contour type.</shortdesc>      <datatype>        <type>ContourOptionsTypes</type>      </datatype>    </property>    <property name="includeInsideEdges">      <shortdesc>If true, creates interior clipping paths within the surrounding clipping path. Note: Valid only when clipping type is alpha channel or detect edges.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="contourPathName">      <shortdesc>The alpha channel or Photoshop path to use for the contour option. Valid only when the contour options is photoshop path or alpha channel.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="contourTolerance">      <shortdesc>The contour tolerance.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="contourThreshold">      <shortdesc>The contour threshold.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="contourAlphaIndex">      <shortdesc>The alpha index used by contour options.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="contourPathIndex">      <shortdesc>The embedded path index used by contour options.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the ContourOption.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>ContourOption</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>