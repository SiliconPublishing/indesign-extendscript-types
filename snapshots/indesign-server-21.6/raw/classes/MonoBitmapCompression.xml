<classdef name="MonoBitmapCompression" enumeration="true">  <shortdesc>The amount and type of compression to apply to monochrome bitmap images.</shortdesc>  <elements type="class">    <property name="NONE" rwaccess="readonly">      <shortdesc>Uses no compression.</shortdesc>      <datatype>        <type>number</type>        <value>1852796517</value>      </datatype>    </property>    <property name="CCIT3" rwaccess="readonly">      <shortdesc>Uses CCITT Group 3 compression.</shortdesc>      <datatype>        <type>number</type>        <value>1128879155</value>      </datatype>    </property>    <property name="CCIT4" rwaccess="readonly">      <shortdesc>Uses CCITT Group 4 compression.</shortdesc>      <datatype>        <type>number</type>        <value>1128879156</value>      </datatype>    </property>    <property name="ZIP" rwaccess="readonly">      <shortdesc>Uses ZIP compression.</shortdesc>      <datatype>        <type>number</type>        <value>2053730371</value>      </datatype>    </property>    <property name="RUN_LENGTH" rwaccess="readonly">      <shortdesc>Uses Run Length compression.</shortdesc>      <datatype>        <type>number</type>        <value>1919839299</value>      </datatype>    </property>  </elements></classdef>