<classdef name="ChangeCaseOptions" enumeration="true">  <shortdesc>Change case options.</shortdesc>  <elements type="class">    <property name="NONE" rwaccess="readonly">      <shortdesc>No conversion.</shortdesc>      <datatype>        <type>number</type>        <value>1852796517</value>      </datatype>    </property>    <property name="UPPERCASE" rwaccess="readonly">      <shortdesc>Converts all letters to uppercase.</shortdesc>      <datatype>        <type>number</type>        <value>1667462499</value>      </datatype>    </property>    <property name="LOWERCASE" rwaccess="readonly">      <shortdesc>Converts all letters to lowercase.</shortdesc>      <datatype>        <type>number</type>        <value>1667460195</value>      </datatype>    </property>    <property name="TITLECASE" rwaccess="readonly">      <shortdesc>Converts the first letter of each word to uppercase.</shortdesc>      <datatype>        <type>number</type>        <value>1667462243</value>      </datatype>    </property>    <property name="SENTENCECASE" rwaccess="readonly">      <shortdesc>Converts the first letter of the first word of each sentence to uppercase.</shortdesc>      <datatype>        <type>number</type>        <value>1667461987</value>      </datatype>    </property>  </elements></classdef>