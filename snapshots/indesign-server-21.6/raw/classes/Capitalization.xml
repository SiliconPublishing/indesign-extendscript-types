<classdef name="Capitalization" enumeration="true">  <shortdesc>Capitalization options.</shortdesc>  <elements type="class">    <property name="NORMAL" rwaccess="readonly">      <shortdesc>Do not change the capitalization of the text.</shortdesc>      <datatype>        <type>number</type>        <value>1852797549</value>      </datatype>    </property>    <property name="SMALL_CAPS" rwaccess="readonly">      <shortdesc>Use small caps for lowercase letters.</shortdesc>      <datatype>        <type>number</type>        <value>1936548720</value>      </datatype>    </property>    <property name="ALL_CAPS" rwaccess="readonly">      <shortdesc>Use all uppercase letters.</shortdesc>      <datatype>        <type>number</type>        <value>1634493296</value>      </datatype>    </property>    <property name="CAP_TO_SMALL_CAP" rwaccess="readonly">      <shortdesc>Use OpenType small caps.</shortdesc>      <datatype>        <type>number</type>        <value>1664250723</value>      </datatype>    </property>    <property name="LOWER_CASE" rwaccess="readonly">      <shortdesc>Use to change to Lower case.</shortdesc>      <datatype>        <type>number</type>        <value>1819244387</value>      </datatype>    </property>  </elements></classdef>