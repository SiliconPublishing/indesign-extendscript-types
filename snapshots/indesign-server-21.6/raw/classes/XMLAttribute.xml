<classdef name="XMLAttribute" dynamic="true">  <shortdesc>An XML attribute.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the XMLAttribute (a XMLElement).</shortdesc>      <datatype>        <type>XMLElement</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the XMLAttribute within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the XMLAttribute.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="value">      <shortdesc>The value of the XMLAttribute.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the XMLAttribute.</shortdesc>    </method>    <method name="convertToElement">      <shortdesc>Converts the XML attribute to a child element of its parent element.</shortdesc>      <parameters>        <parameter name="located" optional="true">          <shortdesc>The location of the new XML element within the parent XML element of the XML attribute. (Optional)</shortdesc>          <datatype>            <type>XMLElementLocation</type>            <value>XMLElementLocation.ELEMENT_START</value>          </datatype>        </parameter>        <parameter name="markupTag">          <shortdesc>The XML tag to apply to the new XML element. (Optional)</shortdesc>          <datatype>            <type>XMLTag</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>XMLElement</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the XMLAttribute.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>XMLAttribute</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>