<classdef name="AlternateGlyphForms" enumeration="true">  <shortdesc>Glyph variant substitution options for standard glyphs.</shortdesc>  <elements type="class">    <property name="NONE" rwaccess="readonly">      <shortdesc>Does not use an alternate form.</shortdesc>      <datatype>        <type>number</type>        <value>1852796517</value>      </datatype>    </property>    <property name="TRADITIONAL_FORM" rwaccess="readonly">      <shortdesc>Uses the traditional variant.</shortdesc>      <datatype>        <type>number</type>        <value>1247897460</value>      </datatype>    </property>    <property name="EXPERT_FORM" rwaccess="readonly">      <shortdesc>Uses the expert variant.</shortdesc>      <datatype>        <type>number</type>        <value>1247897445</value>      </datatype>    </property>    <property name="JIS78_FORM" rwaccess="readonly">      <shortdesc>Uses the JIS78 variant.</shortdesc>      <datatype>        <type>number</type>        <value>1247897399</value>      </datatype>    </property>    <property name="JIS83_FORM" rwaccess="readonly">      <shortdesc>Uses the JIS83 variant.</shortdesc>      <datatype>        <type>number</type>        <value>1247897400</value>      </datatype>    </property>    <property name="MONOSPACED_HALF_WIDTH_FORM" rwaccess="readonly">      <shortdesc>Uses the monospaced half-width variant.</shortdesc>      <datatype>        <type>number</type>        <value>1247897453</value>      </datatype>    </property>    <property name="THIRD_WIDTH_FORM" rwaccess="readonly">      <shortdesc>Uses the third-width variant.</shortdesc>      <datatype>        <type>number</type>        <value>1247897448</value>      </datatype>    </property>    <property name="QUARTER_WIDTH_FORM" rwaccess="readonly">      <shortdesc>Uses the quarter-width variant.</shortdesc>      <datatype>        <type>number</type>        <value>1247897457</value>      </datatype>    </property>    <pro