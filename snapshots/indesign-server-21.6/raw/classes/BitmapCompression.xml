<classdef name="BitmapCompression" enumeration="true">  <shortdesc>The type of compression for bitmap images.</shortdesc>  <elements type="class">    <property name="NONE" rwaccess="readonly">      <shortdesc>Uses no compression.</shortdesc>      <datatype>        <type>number</type>        <value>1852796517</value>      </datatype>    </property>    <property name="AUTO_COMPRESSION" rwaccess="readonly">      <shortdesc>Uses JPEG compression and automatically determines the best quality type. Valid only when acrobat compatibility is acrobat 6 or higher.</shortdesc>      <datatype>        <type>number</type>        <value>1631808880</value>      </datatype>    </property>    <property name="JPEG" rwaccess="readonly">      <shortdesc>Uses JPEG compression.</shortdesc>      <datatype>        <type>number</type>        <value>1785751398</value>      </datatype>    </property>    <property name="ZIP" rwaccess="readonly">      <shortdesc>Uses ZIP compression.</shortdesc>      <datatype>        <type>number</type>        <value>2053730371</value>      </datatype>    </property>    <property name="JPEG_2000" rwaccess="readonly">      <shortdesc>Uses JPEG 2000 compression. Valid only when acrobat compatibility is acrobat 6 or higher.</shortdesc>      <datatype>        <type>number</type>        <value>1785751346</value>      </datatype>    </property>    <property name="AUTOMATIC_JPEG_2000" rwaccess="readonly">      <shortdesc>The Automatic JPEG 2000 compression method.</shortdesc>      <datatype>        <type>number</type>        <value>1634365490</value>      </datatype>    </property>  </elements></classdef>