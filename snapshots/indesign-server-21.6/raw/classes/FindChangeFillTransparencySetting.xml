<classdef name="FindChangeFillTransparencySetting" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Transparency settings for the fill applied to the parent object.</shortdesc>  <elements type="instance">    <property name="blendingSettings" rwaccess="readonly">      <shortdesc>Blending mode settings.</shortdesc>      <datatype>        <type>FindChangeBlendingSetting</type>      </datatype>    </property>    <property name="dropShadowSettings" rwaccess="readonly">      <shortdesc>Settings related to the drop shadow effect.</shortdesc>      <datatype>        <type>FindChangeDropShadowSetting</type>      </datatype>    </property>    <property name="featherSettings" rwaccess="readonly">      <shortdesc>Settings related to the feather effect.</shortdesc>      <datatype>        <type>FindChangeFeatherSetting</type>      </datatype>    </property>    <property name="innerShadowSettings" rwaccess="readonly">      <shortdesc>Settings related to the inner shadow effect.</shortdesc>      <datatype>        <type>FindChangeInnerShadowSetting</type>      </datatype>    </property>    <property name="outerGlowSettings" rwaccess="readonly">      <shortdesc>Settings related to the outer glow effect.</shortdesc>      <datatype>        <type>FindChangeOuterGlowSetting</type>      </datatype>    </property>    <property name="innerGlowSettings" rwaccess="readonly">      <shortdesc>Settings related to the inner glow effect.</shortdesc>      <datatype>        <type>FindChangeInnerGlowSetting</type>      </datatype>    </property>    <property name="bevelAndEmbossSettings" rwaccess="readonly">      <shortdesc>Settings related to the bevel and emboss effect.</shortdesc>      <datatype>        <type>FindChangeBevelAndEmbossSetting</type>      </datatype>    </property>    <property name="satinSettings" rwaccess="readonly">      <shortdesc>Settings related to the satin effect</shortdesc>      <datatype>        <type>FindChangeSatinSetting</type>      </datatype>    </property>    <property name="directionalFeatherSettings" rwaccess="readonly">      <shortdesc>Settings related to the directional feather effect.</shortdesc>      <datatype>        <type>FindChangeDirectionalFeatherSetting</type>      </datatype>    </property>    <property name="gradientFeatherSettings" rwaccess="readonly">      <shortdesc>Settings related to the gradient feather effect.</shortdesc>      <datatype>        <type>FindChangeGradientFeatherSetting</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the FindChangeFillTransparencySetting (a FindObjectPreference or ChangeObjectPreference).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="preferences" rwaccess="readonly">      <shortdesc>A collection of preferences objects.</shortdesc>      <datatype>        <type>Preferences</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the FindChangeFillTransparencySetting.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>FindChangeFillTransparencySetting</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>