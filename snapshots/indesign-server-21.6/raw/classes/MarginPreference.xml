<classdef name="MarginPreference" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Margin preferences.</shortdesc>  <elements type="instance">    <property name="customColumns" rwaccess="readonly">      <shortdesc>If false, columns are evenly spaced. If true, columns can have custom widths.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the MarginPreference (a Application, Document or Page).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="columnCount">      <shortdesc>The number of columns to place on the page.</shortdesc>      <datatype>        <type>number</type>        <min>1</min>        <max>216</max>      </datatype>    </property>    <property name="columnGutter">      <shortdesc>The distance between columns.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <min>0</min>        <max>1440</max>      </datatype>    </property>    <property name="top">      <shortdesc>The top edge of the MarginPreference.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="bottom">      <shortdesc>The bottom edge of the MarginPreference.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="left">      <shortdesc>The left edge of the MarginPreference.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="right">      <shortdesc>The right edge of the MarginPreference.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="columnDirection">      <shortdesc>The direction of text in the column.</shortdesc>      <datatype>        <type>HorizontalOrVertical</type>      </datatype>    </property>    <property name="columnsPositions">      <shortdesc>The distance that each column guide is placed from the left margin, formatted as an array in the format [guide1, guide2, guide3].</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <array/>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the MarginPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>MarginPreference</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>