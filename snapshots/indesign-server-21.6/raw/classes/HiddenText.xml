<classdef name="HiddenText" dynamic="true">  <shortdesc>A hidden text object.</shortdesc>  <elements type="instance">    <property name="storyOffset" rwaccess="readonly">      <shortdesc>The insertion point before the table in the story containing the table.</shortdesc>      <datatype>        <type>InsertionPoint</type>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the HiddenText.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the HiddenText (a Story, XmlStory, TextFrame, EndnoteTextFrame, InsertionPoint, Note, Cell or Footnote).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the HiddenText within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="texts" rwaccess="readonly">      <shortdesc>A collection of text objects.</shortdesc>      <datatype>        <type>Texts</type>      </datatype>    </property>    <property name="characters" rwaccess="readonly">      <shortdesc>A collection of characters.</shortdesc>      <datatype>        <type>Characters</type>      </datatype>    </property>    <property name="words" rwaccess="readonly">      <shortdesc>A collection of words.</shortdesc>      <datatype>        <type>Words</type>      </datatype>    </property>    <property name="lines" rwaccess="readonly">      <shortdesc>A collection of lines.</shortdesc>      <datatype>        <type>Lines</type>      </datatype>    </property>    <property name="textColumns" rwaccess="readonly">      <shortdesc>A collection of text columns.</shortdesc>      <datatype>        <type>TextColumns</type>      </datatype>    </property>    <property name="paragraphs" rwaccess="readonly">      <shortdesc>A collection of paragraphs.</shortdesc>      <datatype>        <type>Paragraphs</type>      </datatype>    </property>    <property name="insertionPoints" rwaccess="readonly">      <shortdesc>A collection of insertion points.</shortdesc>      <datatype>        <type>InsertionPoints</type>      </datatype>    </property>    <property name="textStyleRanges" rwaccess="readonly">      <shortdesc>A collection of text style ranges.</shortdesc>      <datatype>        <type>TextStyleRanges</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the HiddenText; this is an alias to the HiddenText's label property.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the HiddenText.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>HiddenText</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>