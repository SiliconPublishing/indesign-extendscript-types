<classdef name="DashedStrokeStyle" dynamic="true">  <superclass href="#/StrokeStyle">StrokeStyle</superclass>  <shortdesc>A dashed stroke style.</shortdesc>  <elements type="instance">    <property name="strokeStyleType" rwaccess="readonly">      <shortdesc>The stroke style type.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the DashedStrokeStyle.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the DashedStrokeStyle (a Document or Application).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the DashedStrokeStyle within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="dashArray">      <shortdesc>The pattern of dashes and gaps, in the format [dash length1, gap length1, dash length2, gap length2]. Define up to ten values.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <array/>      </datatype>    </property>    <property name="strokeCornerAdjustment">      <shortdesc>The corner adjustment applied to the DashedStrokeStyle.</shortdesc>      <datatype>        <type>StrokeCornerAdjustment</type>      </datatype>    </property>    <property name="endCap">      <shortdesc>The end shape of an open path.</shortdesc>      <datatype>        <type>EndCap</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the DashedStrokeStyle.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="duplicate">      <shortdesc>Duplicates the DashedStrokeStyle.</shortdesc>      <datatype>        <type>DashedStrokeStyle</type>      </datatype>    </method>    <method name="remove">      <shortdesc>Deletes the stroke style.</shortdesc>      <parameters>        <parameter name="replacingWith">          <shortdesc>The stroke style to apply in place of the deleted style. . Can accept: StrokeStyle or String. (Optional)</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the DashedStrokeStyle.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>DashedStrokeStyle</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>