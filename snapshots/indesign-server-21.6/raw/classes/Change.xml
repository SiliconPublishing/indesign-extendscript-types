<classdef name="Change" dynamic="true">  <shortdesc>A tracked change made to a story.</shortdesc>  <elements type="instance">    <property name="date" rwaccess="readonly">      <shortdesc>The date on which the tracked change was made. Note: Valid only when track changes is true.</shortdesc>      <datatype>        <type>Date</type>      </datatype>    </property>    <property name="changeType" rwaccess="readonly">      <shortdesc>The type of tracked change. Note: Valid only when track changes is true.</shortdesc>      <datatype>        <type>ChangeTypes</type>      </datatype>    </property>    <property name="userName" rwaccess="readonly">      <shortdesc>The user who made the change. Note: Valid only when track changes is true.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="storyOffset" rwaccess="readonly">      <shortdesc>The location of the first insertion point in the object (relative to the beginning of the story).</shortdesc>      <datatype>        <type>InsertionPoint</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the Change (a Story, XmlStory or Cell).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the Change within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="texts" rwaccess="readonly">      <shortdesc>A collection of text objects.</shortdesc>      <datatype>        <type>Texts</type>      </datatype>    </property>    <property name="characters" rwaccess="readonly">      <shortdesc>A collection of characters.</shortdesc>      <datatype>        <type>Characters</type>      </datatype>    </property>    <property name="words" rwaccess="readonly">      <shortdesc>A collection of words.</shortdesc>      <datatype>        <type>Words</type>      </datatype>    </property>    <property name="lines" rwaccess="readonly">      <shortdesc>A collection of lines.</shortdesc>      <datatype>        <type>Lines</type>      </datatype>    </property>    <property name="textColumns" rwaccess="readonly">      <shortdesc>A collection of text columns.</shortdesc>      <datatype>        <type>TextColumns</type>      </datatype>    </property>    <property name="paragraphs" rwaccess="readonly">      <shortdesc>A collection of paragraphs.</shortdesc>      <datatype>        <type>Paragraphs</type>      </datatype>    </property>    <property name="insertionPoints" rwaccess="readonly">      <shortdesc>A collection of insertion points.</shortdesc>      <datatype>        <type>InsertionPoints</type>      </datatype>    </property>    <property name="textStyleRanges" rwaccess="readonly">      <shortdesc>A collection of text style ranges.</shortdesc>      <datatype>        <type>TextStyleRanges</type>      </datatype>    </property>    <property name="textVariableInstances" rwaccess="readonly">      <shortdesc>A collection of text variable instances.</shortdesc>      <datatype>        <type>TextVariableInstances</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="accept">      <shortdesc>Accepts the tracked change. Note: Valid only when track changes is true.</shortdesc>    </method>    <method name="reject">      <shortdesc>Rejects the tracked change. Note: Valid only when track changes is true.</shortdesc>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the Change.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>Change</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>