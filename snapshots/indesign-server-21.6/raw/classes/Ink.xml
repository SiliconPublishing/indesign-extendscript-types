<classdef name="Ink" dynamic="true">  <shortdesc>An ink.</shortdesc>  <elements type="instance">    <property name="isProcessInk" rwaccess="readonly">      <shortdesc>If true, the ink is a process ink.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="name" rwaccess="readonly">      <shortdesc>The name of the Ink.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="solidity" rwaccess="readonly">      <shortdesc>The solidity value of the ink. (Range: 0.0 to 1.0)</shortdesc>      <datatype>        <type>number</type>        <min>0</min>        <max>1</max>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the Ink.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the Ink (a Application or Document).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the Ink within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="aliasInkName">      <shortdesc>The ink object to map this ink to.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="angle">      <shortdesc>The angle of the ink. (Range: 0 to 360)</shortdesc>      <datatype>        <type>number</type>        <min>0</min>        <max>360</max>      </datatype>    </property>    <property name="convertToProcess">      <shortdesc>Converts spot inks to process inks.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="frequency">      <shortdesc>The frequency of the ink. (Range: 1 to 500)</shortdesc>      <datatype>        <type>number</type>        <min>1</min>        <max>500</max>      </datatype>    </property>    <property name="neutralDensity">      <shortdesc>The neutral density of the ink. (Range: 0.001 to 10.0)</shortdesc>      <datatype>        <type>number</type>        <min>0.001</min>        <max>10</max>      </datatype>    </property>    <property name="printInk">      <shortdesc>If true, prints the ink. Only valid when printing separations.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="trapOrder">      <shortdesc>The place of the ink in the trapping sequence.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="inkType">      <shortdesc>The trapping type of the ink.</shortdesc>      <datatype>        <type>InkTypes</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the Ink.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>Ink</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>