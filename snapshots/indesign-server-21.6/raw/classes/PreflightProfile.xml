<classdef name="PreflightProfile" dynamic="true">  <shortdesc>A preflight profile.</shortdesc>  <elements type="instance">    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the PreflightProfile.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the PreflightProfile (a Application or Document).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the PreflightProfile within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="preflightProfileRules" rwaccess="readonly">      <shortdesc>A collection of preflight profile rules.</shortdesc>      <datatype>        <type>PreflightProfileRules</type>      </datatype>    </property>    <property name="preflightRuleInstances" rwaccess="readonly">      <shortdesc>A collection of preflight rule instances.</shortdesc>      <datatype>        <type>PreflightRuleInstances</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the PreflightProfile.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="description">      <shortdesc>The description of the PreflightProfile.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the PreflightProfile.</shortdesc>    </method>    <method name="duplicate">      <shortdesc>Duplicates the PreflightProfile.</shortdesc>      <datatype>        <type>PreflightProfile</type>      </datatype>    </method>    <method name="update">      <shortdesc>Update the preflight profile by copying from another profile.</shortdesc>      <parameters>        <parameter name="using">          <shortdesc>The preflight profile to copy. Can accept: String or PreflightProfile. (Optional)</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="unembed">      <shortdesc>Unembed this profile.</shortdesc>    </method>    <method name="save">      <shortdesc>Saves this preflight profile to a InDesign preflight profile file.</shortdesc>      <parameters>        <parameter name="to">          <shortdesc>The preflight profile file to save to.</shortdesc>          <datatype>            <type>File</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the PreflightProfile.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>PreflightProfile</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>