<classdef name="GlobalClashResolutionStrategyForMasterPage" enumeration="true">  <shortdesc>Resolution options when loaded master pages have the same name as existing masterpages.</shortdesc>  <elements type="class">    <property name="LOAD_ALL_WITH_OVERWRITE" rwaccess="readonly">      <shortdesc>Overwrites the existing master page.</shortdesc>      <datatype>        <type>number</type>        <value>1279350607</value>      </datatype>    </property>    <property name="LOAD_ALL_WITH_RENAME" rwaccess="readonly">      <shortdesc>Renames the new master page.</shortdesc>      <datatype>        <type>number</type>        <value>1279350610</value>      </datatype>    </property>  </elements></classdef>