<classdef name="State" dynamic="true">  <shortdesc>A state (states define the display of the field in an exported PDF).</shortdesc>  <elements type="instance">    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the State.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the State (a Button, MultiStateObject, CheckBox or RadioButton).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the State within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="images" rwaccess="readonly">      <shortdesc>A collection of bitmap images in any bitmap file format (including TIFF, JPEG, or GIF).</shortdesc>      <datatype>        <type>Images</type>      </datatype>    </property>    <property name="graphics" rwaccess="readonly">      <shortdesc>A collection of imported graphics in any graphic file format (vector, metafile, or bitmap).</shortdesc>      <datatype>        <type>Graphics</type>      </datatype>    </property>    <property name="pageItems" rwaccess="readonly">      <shortdesc>The page items collection, which can be used to process all page items in a container (such as a document, page, or group), regardless of type.</shortdesc>      <datatype>        <type>PageItems</type>      </datatype>    </property>    <property name="epss" rwaccess="readonly">      <shortdesc>A collection of EPS files.</shortdesc>      <datatype>        <type>EPSs</type>      </datatype>    </property>    <property name="wmfs" rwaccess="readonly">      <shortdesc>A collection of WMF graphics.</shortdesc>      <datatype>        <type>WMFs</type>      </datatype>    </property>    <property name="picts" rwaccess="readonly">      <shortdesc>A collection of PICT graphics.</shortdesc>      <datatype>        <type>PICTs</type>      </datatype>    </property>    <property name="pdfs" rwaccess="readonly">      <shortdesc>A collection of PDF files.</shortdesc>      <datatype>        <type>PDFs</type>      </datatype>    </property>    <property name="groups" rwaccess="readonly">      <shortdesc>A collection of groups.</shortdesc>      <datatype>        <type>Groups</type>      </datatype>    </property>    <property name="epstexts" rwaccess="readonly">      <shortdesc>EPSTexts</shortdesc>      <datatype>        <type>EPSTexts</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="ovals" rwaccess="readonly">      <shortdesc>A collection of ellipses.</shortdesc>      <datatype>        <type>Ovals</type>      </datatype>    </property>    <property name="splineItems" rwaccess="readonly">      <shortdesc>The spline items collection.</shortdesc>      <datatype>        <type>SplineItems</type>      </datatype>    </property>    <property name="rectangles" rwaccess="readonly">      <shortdesc>A collection of rectangles.</shortdesc>      <datatype>        <type>Rectangles</type>      </datatype>    </property>    <property name="graphicLines" rwaccess="readonly">      <shortdesc>A collection of graphic lines.</shortdesc>      <datatype>        <type>GraphicLines</type>      </datatype>    </property>    <property name="textFrames" rwaccess="readonly">      <shortdesc>A collection of text frames.</shortdesc>      <datatype>        <type>TextFrames</type>      </datatype>    </property>    <property name="polygons" rwaccess="readonly">      <shortdesc>A collection of polygons.</shortdesc>      <datatype>        <type>Polygons</type>      </datatype>    </property>    <property name="endnoteTextFrames" rwaccess="readonly">      <shortdesc>A collection of endnote text frames.</shortdesc>      <datatype>        <type>EndnoteTextFrames</type>      </datatype>    </property>    <property name="svgs" rwaccess="readonly">      <shortdesc>A collection of SVG files.</shortdesc>      <datatype>        <type>SVGs</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the State.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="active">      <shortdesc>If true, the state is active in the exported PDF.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="enabled">      <shortdesc>If true, the state is enabled in PDF documents.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="statetype">      <shortdesc>For a button, the type of user action that dictates the object's appearance. For a MultiStateObject, which has no user actions associated with states, this property is a numeric value uniquely identifying the state. Can return: StateTypes enumerator or Long Integer.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="releaseAsObject">      <shortdesc>Releases this state's appearance as a page item, removing the state from its parent object.</shortdesc>    </method>    <method name="move">      <shortdesc>Moves the state to a new position in its parent collection.</shortdesc>      <parameters>        <parameter name="newPosition">          <shortdesc>the index to move the state to in its parent collection</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="addItemsToState">      <shortdesc>Adds page items to this state.</shortdesc>      <parameters>        <parameter name="pageitems">          <shortdesc>One or more page items to add to this state.</shortdesc>          <datatype>            <type>PageItem</type>            <array/>          </datatype>        </parameter>      </parameters>    </method>    <method name="remove">      <shortdesc>Deletes the State.</shortdesc>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the State.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>State</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>