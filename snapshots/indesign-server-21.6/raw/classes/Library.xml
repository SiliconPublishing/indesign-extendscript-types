<classdef name="Library" dynamic="true">  <shortdesc>An object library.</shortdesc>  <elements type="instance">    <property name="name" rwaccess="readonly">      <shortdesc>The name of the Library.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="fullName" rwaccess="readonly">      <shortdesc>The full path to the Library, including the name of the Library.</shortdesc>      <datatype>        <type>File</type>      </datatype>    </property>    <property name="filePath" rwaccess="readonly">      <shortdesc>The full path to the file.</shortdesc>      <datatype>        <type>File</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the Library (a Application).</shortdesc>      <datatype>        <type>Application</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the Library within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="assets" rwaccess="readonly">      <shortdesc>A collection of object library assets.</shortdesc>      <datatype>        <type>Assets</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="close">      <shortdesc>Closes the Library.</shortdesc>    </method>    <method name="store">      <shortdesc>Stores the specified object in the library.</shortdesc>      <parameters>        <parameter name="using">          <shortdesc>The page item(s) to store. Can accept: Array of PageItems, Movies, Sounds, Graphics or XMLElements.</shortdesc>          <datatype>            <type>varies=any</type>            <array/>          </datatype>        </parameter>        <parameter name="withProperties">          <shortdesc>Initial values for properties of the new Library (Optional)</shortdesc>          <datatype>            <type>Object</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>Asset</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the Library.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>Library</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>