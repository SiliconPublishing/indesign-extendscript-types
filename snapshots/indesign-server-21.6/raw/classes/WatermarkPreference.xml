<classdef name="WatermarkPreference" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Watermark preference</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the WatermarkPreference (a Document or Application).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="watermarkVisibility">      <shortdesc>Watermark visibility for a document</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="watermarkDoPrint">      <shortdesc>Watermark do print for a document</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="watermarkDrawInBack">      <shortdesc>Watermark draw in back for a document</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="watermarkText">      <shortdesc>Watermark text for a document</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="watermarkFontFamily">      <shortdesc>Watermark font family display name</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="watermarkFontStyle">      <shortdesc>Watermark font style name</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="watermarkFontPointSize">      <shortdesc>Watermark font point size for a document</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="watermarkFontColor">      <shortdesc>Watermark font color for a document. Can return: Array of 3 Reals (0 - 255) or UIColors enumerator.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="watermarkOpacity">      <shortdesc>Watermark opacity (as a percentage). (Range: 0 to 100)</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="watermarkRotation">      <shortdesc>Watermark rotation for a document</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="watermarkHorizontalPosition">      <shortdesc>Watermark horizontal position enum for a document</shortdesc>      <datatype>        <type>WatermarkHorizontalPositionEnum</type>      </datatype>    </property>    <property name="watermarkHorizontalOffset">      <shortdesc>Watermark horizontal offset for a document</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="watermarkVerticalPosition">      <shortdesc>Watermark vertical position enum for a document</shortdesc>      <datatype>        <type>WatermarkVerticalPositionEnum</type>      </datatype>    </property>    <property name="watermarkVerticalOffset">      <shortdesc>Watermark vertical offset for a document</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the WatermarkPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>WatermarkPreference</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>