<classdef name="ImportedPageCropOptions" enumeration="true">  <shortdesc>The cropping option of an imported InDesign page.</shortdesc>  <elements type="class">    <property name="CROP_CONTENT" rwaccess="readonly">      <shortdesc>Places the page's bounding box.</shortdesc>      <datatype>        <type>number</type>        <value>1131573315</value>      </datatype>    </property>    <property name="CROP_BLEED" rwaccess="readonly">      <shortdesc>Places the page's bleed area.</shortdesc>      <datatype>        <type>number</type>        <value>1131573314</value>      </datatype>    </property>    <property name="CROP_SLUG" rwaccess="readonly">      <shortdesc>Places the page's slug area.</shortdesc>      <datatype>        <type>number</type>        <value>1131565932</value>      </datatype>    </property>  </elements></classdef>