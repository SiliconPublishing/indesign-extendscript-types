<classdef name="Layer" dynamic="true">  <shortdesc>A layer.</shortdesc>  <elements type="instance">    <property name="allPageItems" rwaccess="readonly">      <shortdesc>Lists all page items contained by the Layer.</shortdesc>      <datatype>        <type>PageItem</type>        <array/>      </datatype>    </property>    <property name="allGraphics" rwaccess="readonly">      <shortdesc>Lists all graphics contained by the Layer.</shortdesc>      <datatype>        <type>Graphic</type>        <array/>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the Layer.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the Layer (a Document).</shortdesc>      <datatype>        <type>Document</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the Layer within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="formFields" rwaccess="readonly">      <shortdesc>A collection of form fields.</shortdesc>      <datatype>        <type>FormFields</type>      </datatype>    </property>    <property name="pageItems" rwaccess="readonly">      <shortdesc>The page items collection, which can be used to process all page items in a container (such as a document, page, or group), regardless of type.</shortdesc>      <datatype>        <type>PageItems</type>      </datatype>    </property>    <property name="buttons" rwaccess="readonly">      <shortdesc>A collection of buttons.</shortdesc>      <datatype>        <type>Buttons</type>      </datatype>    </property>    <property name="multiStateObjects" rwaccess="readonly">      <shortdesc>A collection of multi-state objects.</shortdesc>      <datatype>        <type>MultiStateObjects</type>      </datatype>    </property>    <property name="checkBoxes" rwaccess="readonly">      <shortdesc>A collection of checkboxes.</shortdesc>      <datatype>        <type>CheckBoxes</type>      </datatype>    </property>    <property name="comboBoxes" rwaccess="readonly">      <shortdesc>A collection of comboboxes.</shortdesc>      <datatype>        <type>ComboBoxes</type>      </datatype>    </property>    <property name="listBoxes" rwaccess="readonly">      <shortdesc>A collection of listboxes.</shortdesc>      <datatype>        <type>ListBoxes</type>      </datatype>    </property>    <property name="radioButtons" rwaccess="readonly">      <shortdesc>A collection of radio buttons.</shortdesc>      <datatype>        <type>RadioButtons</type>      </datatype>    </property>    <property name="textBoxes" rwaccess="readonly">      <shortdesc>A collection of text boxes.</shortdesc>      <datatype>        <type>TextBoxes</type>      </datatype>    </property>    <property name="signatureFields" rwaccess="readonly">      <shortdesc>A collection of signature fields.</shortdesc>      <datatype>        <type>SignatureFields</type>      </datatype>    </property>    <property name="groups" rwaccess="readonly">      <shortdesc>A collection of groups.</shortdesc>      <datatype>        <type>Groups</type>      </datatype>    </property>    <property name="epstexts" rwaccess="readonly">      <shortdesc>EPSTexts</shortdesc>      <datatype>        <type>EPSTexts</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="ovals" rwaccess="readonly">      <shortdesc>A collection of ellipses.</shortdesc>      <datatype>        <type>Ovals</type>      </datatype>    </property>    <property name="splineItems" rwaccess="readonly">      <shortdesc>The spline items collection.</shortdesc>      <datatype>        <type>SplineItems</type>      </datatype>    </property>    <property name="rectangles" rwaccess="readonly">      <shortdesc>A collection of rectangles.</shortdesc>      <datatype>        <type>Rectangles</type>      </datatype>    </property>    <property name="graphicLines" rwaccess="readonly">      <shortdesc>A collection of graphic lines.</shortdesc>      <datatype>        <type>GraphicLines</type>      </datatype>    </property>    <property name="textFrames" rwaccess="readonly">      <shortdesc>A collection of text frames.</shortdesc>      <datatype>        <type>TextFrames</type>      </datatype>    </property>    <property name="polygons" rwaccess="readonly">      <shortdesc>A collection of polygons.</shortdesc>      <datatype>        <type>Polygons</type>      </datatype>    </property>    <property name="endnoteTextFrames" rwaccess="readonly">      <shortdesc>A collection of endnote text frames.</shortdesc>      <datatype>        <type>EndnoteTextFrames</type>      </datatype>    </property>    <property name="guides" rwaccess="readonly">      <shortdesc>A collection of guides.</shortdesc>      <datatype>        <type>Guides</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the Layer.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="visible">      <shortdesc>If true, the Layer is visible.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="locked">      <shortdesc>If true, the Layer is locked.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="layerColor">      <shortdesc>The color of the layer, specified either as an array of three doubles, each in the range 0 to 255 and representing R, G, and B values, or as a UI color. Can return: Array of 3 Reals (0 - 255) or UIColors enumerator.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="ignoreWrap">      <shortdesc>If true, text wrap settings applied to objects on the layer will not affect text on other layers when the layer is hidden.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="showGuides">      <shortdesc>If true, guides are visible on the layer.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="lockGuides">      <shortdesc>If true, the guide positions on the layer are locked.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="printable">      <shortdesc>If true, the layer will print.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="move">      <shortdesc>Moves the Layer to the specified location.</shortdesc>      <parameters>        <parameter name="to">          <shortdesc>The location relative to the reference object or within the containing object.</shortdesc>          <datatype>            <type>LocationOptions</type>          </datatype>        </parameter>        <parameter name="reference">          <shortdesc>The reference object. Note: Required when the to value specifies before or after. (Optional)</shortdesc>          <datatype>            <type>Layer</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>Layer</type>      </datatype>    </method>    <method name="remove">      <shortdesc>Deletes the Layer.</shortdesc>    </method>    <method name="duplicate">      <shortdesc>Duplicates the Layer.</shortdesc>      <datatype>        <type>Layer</type>      </datatype>    </method>    <method name="merge">      <shortdesc>Merges the layer with other layer(s).</shortdesc>      <parameters>        <parameter name="with">          <shortdesc>The layer(s) with which to merge.</shortdesc>          <datatype>            <type>Layer</type>            <array/>          </datatype>        </parameter>      </parameters>      <datatype>        <type>Layer</type>      </datatype>    </method>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the Layer.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>Layer</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>