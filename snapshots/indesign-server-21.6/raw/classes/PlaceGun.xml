<classdef name="PlaceGun" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Represents the place gun.</shortdesc>  <elements type="instance">    <property name="loaded" rwaccess="readonly">      <shortdesc>Whether the place gun is currently loaded with content for placing.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the PlaceGun (a Document).</shortdesc>      <datatype>        <type>Document</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="pageItems" rwaccess="readonly">      <shortdesc>The page items collection, which can be used to process all page items in a container (such as a document, page, or group), regardless of type.</shortdesc>      <datatype>        <type>PageItems</type>      </datatype>    </property>    <property name="textFrames" rwaccess="readonly">      <shortdesc>A collection of text frames.</shortdesc>      <datatype>        <type>TextFrames</type>      </datatype>    </property>    <property name="rectangles" rwaccess="readonly">      <shortdesc>A collection of rectangles.</shortdesc>      <datatype>        <type>Rectangles</type>      </datatype>    </property>    <property name="splineItems" rwaccess="readonly">      <shortdesc>The spline items collection.</shortdesc>      <datatype>        <type>SplineItems</type>      </datatype>    </property>    <property name="ovals" rwaccess="readonly">      <shortdesc>A collection of ellipses.</shortdesc>      <datatype>        <type>Ovals</type>      </datatype>    </property>    <property name="graphicLines" rwaccess="readonly">      <shortdesc>A collection of graphic lines.</shortdesc>      <datatype>        <type>GraphicLines</type>      </datatype>    </property>    <property name="polygons" rwaccess="readonly">      <shortdesc>A collection of polygons.</shortdesc>      <datatype>        <type>Polygons</type>      </datatype>    </property>    <property name="groups" rwaccess="readonly">      <shortdesc>A collection of groups.</shortdesc>      <datatype>        <type>Groups</type>      </datatype>    </property>    <property name="buttons" rwaccess="readonly">      <shortdesc>A collection of buttons.</shortdesc>      <datatype>        <type>Buttons</type>      </datatype>    </property>    <property name="formFields" rwaccess="readonly">      <shortdesc>A collection of form fields.</shortdesc>      <datatype>        <type>FormFields</type>      </datatype>    </property>    <property name="multiStateObjects" rwaccess="readonly">      <shortdesc>A collection of multi-state objects.</shortdesc>      <datatype>        <type>MultiStateObjects</type>      </datatype>    </property>    <property name="epstexts" rwaccess="readonly">      <shortdesc>EPSTexts</shortdesc>      <datatype>        <type>EPSTexts</type>      </datatype>    </property>    <property name="images" rwaccess="readonly">      <shortdesc>A collection of bitmap images in any bitmap file format (including TIFF, JPEG, or GIF).</shortdesc>      <datatype>        <type>Images</type>      </datatype>    </property>    <property name="graphics" rwaccess="readonly">      <shortdesc>A collection of imported graphics in any graphic file format (vector, metafile, or bitmap).</shortdesc>      <datatype>        <type>Graphics</type>      </datatype>    </property>    <property name="epss" rwaccess="readonly">      <shortdesc>A collection of EPS files.</shortdesc>      <datatype>        <type>EPSs</type>      </datatype>    </property>    <property name="wmfs" rwaccess="readonly">      <shortdesc>A collection of WMF graphics.</shortdesc>      <datatype>        <type>WMFs</type>      </datatype>    </property>    <property name="picts" rwaccess="readonly">      <shortdesc>A collection of PICT graphics.</shortdesc>      <datatype>        <type>PICTs</type>      </datatype>    </property>    <property name="pdfs" rwaccess="readonly">      <shortdesc>A collection of PDF files.</shortdesc>      <datatype>        <type>PDFs</type>      </datatype>    </property>    <property name="importedPages" rwaccess="readonly">      <shortdesc>Imported InDesign pages.</shortdesc>      <datatype>        <type>ImportedPages</type>      </datatype>    </property>    <property name="checkBoxes" rwaccess="readonly">      <shortdesc>A collection of checkboxes.</shortdesc>      <datatype>        <type>CheckBoxes</type>      </datatype>    </property>    <property name="comboBoxes" rwaccess="readonly">      <shortdesc>A collection of comboboxes.</shortdesc>      <datatype>        <type>ComboBoxes</type>      </datatype>    </property>    <property name="listBoxes" rwaccess="readonly">      <shortdesc>A collection of listboxes.</shortdesc>      <datatype>        <type>ListBoxes</type>      </datatype>    </property>    <property name="radioButtons" rwaccess="readonly">      <shortdesc>A collection of radio buttons.</shortdesc>      <datatype>        <type>RadioButtons</type>      </datatype>    </property>    <property name="textBoxes" rwaccess="readonly">      <shortdesc>A collection of text boxes.</shortdesc>      <datatype>        <type>TextBoxes</type>      </datatype>    </property>    <property name="signatureFields" rwaccess="readonly">      <shortdesc>A collection of signature fields.</shortdesc>      <datatype>        <type>SignatureFields</type>      </datatype>    </property>    <property name="svgs" rwaccess="readonly">      <shortdesc>A collection of SVG files.</shortdesc>      <datatype>        <type>SVGs</type>      </datatype>    </property>    <property name="snippets" rwaccess="readonly">      <shortdesc>A collection of IDML snippets.</shortdesc>      <datatype>        <type>Snippets</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="abortPlaceGun">      <shortdesc>Delete the contents of the place gun.</shortdesc>    </method>    <method name="rotate">      <shortdesc>Rotate the contents of the place gun.</shortdesc>      <parameters>        <parameter name="direction" optional="true">          <shortdesc>Which direction to rotate the contents (Optional)</shortdesc>          <datatype>            <type>RotationDirection</type>            <value>RotationDirection.FORWARD</value>          </datatype>        </parameter>      </parameters>    </method>    <method name="loadPlaceGun">      <shortdesc>Load the place gun with one or more files.</shortdesc>      <parameters>        <parameter name="fileName">          <shortdesc>One or more files to place. Can accept: File or Array of Files.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="showingOptions" optional="true">          <shortdesc>Whether to display the import options dialog (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>        <parameter name="withProperties">          <shortdesc>Initial values for properties of the placed object(s) (Optional)</shortdesc>          <datatype>            <type>Object</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the PlaceGun.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>PlaceGun</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>