<classdef name="EpubAriaLabelSourceType" enumeration="true">  <shortdesc>ARIA label source type options for EPUB export.</shortdesc>  <elements type="class">    <property name="AUTOMATIC_ARIA_LABEL" rwaccess="readonly">      <shortdesc>Automatically derive the aria-label.</shortdesc>      <datatype>        <type>number</type>        <value>1095516533</value>      </datatype>    </property>    <property name="CUSTOM_ARIA_LABEL" rwaccess="readonly">      <shortdesc>Use the custom aria-label string.</shortdesc>      <datatype>        <type>number</type>        <value>1095517045</value>      </datatype>    </property>    <property name="NONE_ARIA_LABEL" rwaccess="readonly">      <shortdesc>Do not emit an aria-label.</shortdesc>      <datatype>        <type>number</type>        <value>1095519855</value>      </datatype>    </property>  </elements></classdef>