<classdef name="PDFComment" dynamic="true">  <shortdesc>PDF comment object</shortdesc>  <elements type="instance">    <property name="commentReviewer" rwaccess="readonly">      <shortdesc>The name of the reviewer who made the comment</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="commentContent" rwaccess="readonly">      <shortdesc>The content of the comment</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="commentDate" rwaccess="readonly">      <shortdesc>The date of the comment</shortdesc>      <datatype>        <type>Date</type>      </datatype>    </property>    <property name="commentType" rwaccess="readonly">      <shortdesc>The type of the comment</shortdesc>      <datatype>        <type>CommentTypeEnum</type>      </datatype>    </property>    <property name="commentFilePath" rwaccess="readonly">      <shortdesc>The file path of the comment</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="commentPathGeometry" rwaccess="readonly">      <shortdesc>Path geometry of the comment. Can return: Ordered array containing pathPointArray:Array of Ordered array containing anchor:Array of 2 Reals, leftDirection:Array of 2 Reals, rightDirection:Array of 2 Reals, pathOpen:Boolean.</shortdesc>      <datatype>        <type>varies=any</type>        <array/>      </datatype>    </property>    <property name="commentStatus" rwaccess="readonly">      <shortdesc>The status of the comment</shortdesc>      <datatype>        <type>CommentStatusEnum</type>      </datatype>    </property>    <property name="commentIsOrphan" rwaccess="readonly">      <shortdesc>Whether the comment is an orphan</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="commentIsApplied" rwaccess="readonly">      <shortdesc>Whether the comment has been applied</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the PDFComment.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the PDFComment (a Document).</shortdesc>      <datatype>        <type>Document</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the PDFComment within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="replies" rwaccess="readonly">      <shortdesc>A collection of reply objects</shortdesc>      <datatype>        <type>Replies</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="name">      <shortdesc>The name of the PDFComment; this is an alias to the PDFComment's label property.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the PDFComment.</shortdesc>    </method>    <method name="changeStatus">      <shortdesc>Change the status of a comment</shortdesc>      <parameters>        <parameter name="commentStatus">          <shortdesc>The new status of the comment</shortdesc>          <datatype>            <type>CommentStatusEnum</type>          </datatype>        </parameter>        <parameter name="withProperties">          <shortdesc>Initial values for properties of the new PDFComment (Optional)</shortdesc>          <datatype>            <type>Object</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the PDFComment.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>PDFComment</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>