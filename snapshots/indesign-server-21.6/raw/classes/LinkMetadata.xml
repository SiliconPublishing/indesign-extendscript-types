<classdef name="LinkMetadata" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>MetaData properties for the link source file.</shortdesc>  <elements type="instance">    <property name="author" rwaccess="readonly">      <shortdesc>The author of the document.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="description" rwaccess="readonly">      <shortdesc>The description of the LinkMetadata.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="jobName" rwaccess="readonly">      <shortdesc>The job name.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="copyrightStatus" rwaccess="readonly">      <shortdesc>The copyright status of the document.</shortdesc>      <datatype>        <type>CopyrightStatus</type>      </datatype>    </property>    <property name="copyrightNotice" rwaccess="readonly">      <shortdesc>The text to use as a copyright notice.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="copyrightInfoURL" rwaccess="readonly">      <shortdesc>The URL of the file that contains the linked copyright statement.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="keywords" rwaccess="readonly">      <shortdesc>The list of keywords associated with the document.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="serverURL" rwaccess="readonly">      <shortdesc>The location of the document on the asset management server.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="modificationDate" rwaccess="readonly">      <shortdesc>The most recent modification date of the document.</shortdesc>      <datatype>        <type>Date</type>      </datatype>    </property>    <property name="creationDate" rwaccess="readonly">      <shortdesc>The creation date of the document.</shortdesc>      <datatype>        <type>Date</type>      </datatype>    </property>    <property name="documentTitle" rwaccess="readonly">      <shortdesc>The title of the document.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="creator" rwaccess="readonly">      <shortdesc>The name of the application used to create the document.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="format" rwaccess="readonly">      <shortdesc>The format of the document.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the LinkMetadata (a Link).</shortdesc>      <datatype>        <type>Link</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="getProperty">      <shortdesc>Gets the XMP property value associated with the specified path.</shortdesc>      <parameters>        <parameter name="namespace">          <shortdesc>The namespace of the property.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="path">          <shortdesc>The specified path.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="countContainer">      <shortdesc>Counts the number of items in the container.</shortdesc>      <parameters>        <parameter name="namespace">          <shortdesc>The namespace of the container.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="path">          <shortdesc>The path to the container.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>number</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the LinkMetadata.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>LinkMetadata</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>