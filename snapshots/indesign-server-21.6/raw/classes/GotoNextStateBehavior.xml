<classdef name="GotoNextStateBehavior" dynamic="true">  <superclass href="#/Behavior">Behavior</superclass>  <shortdesc>A goto next state behavior.</shortdesc>  <elements type="instance">    <property name="name" rwaccess="readonly">      <shortdesc>The name of the GotoNextStateBehavior.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="id" rwaccess="readonly">      <shortdesc>The unique ID of the GotoNextStateBehavior.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the GotoNextStateBehavior (a Button).</shortdesc>      <datatype>        <type>Button</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the GotoNextStateBehavior within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="associatedMultiStateObject">      <shortdesc>The associated multi-state object page item.</shortdesc>      <datatype>        <type>MultiStateObject</type>      </datatype>    </property>    <property name="loopsToNextOrPrevious">      <shortdesc>If true, will loop to the next or previous state.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="enableBehavior">      <shortdesc>If true, the behavior is enabled.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="behaviorEvent">      <shortdesc>The event which triggers the behavior.</shortdesc>      <datatype>        <type>BehaviorEvents</type>      </datatype>    </property>    <property name="label">      <shortdesc>A property that can be set to any string.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the GotoNextStateBehavior.</shortdesc>    </method>    <method name="insertLabel">      <shortdesc>Sets the label to the value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="value">          <shortdesc>The value.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="extractLabel">      <shortdesc>Gets the label value associated with the specified key.</shortdesc>      <parameters>        <parameter name="key">          <shortdesc>The key.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the GotoNextStateBehavior.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>GotoNextStateBehavior</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>