<classdef name="PathPoint" dynamic="true">  <shortdesc>A path point of a path.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the PathPoint (a Path).</shortdesc>      <datatype>        <type>Path</type>      </datatype>    </property>    <property name="index" rwaccess="readonly">      <shortdesc>The index of the PathPoint within its containing object.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="pointType">      <shortdesc>The path point type.</shortdesc>      <datatype>        <type>PointType</type>      </datatype>    </property>    <property name="anchor">      <shortdesc>The location of the path point on the page, in the format [x, y].</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <array/>      </datatype>    </property>    <property name="leftDirection">      <shortdesc>The left-direction point, which controls the curve of the line segment preceding the path point on the path, in the format [x, y].</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <array/>      </datatype>    </property>    <property name="rightDirection">      <shortdesc>The right-direction point, which controls the curve of the line segment following the path point on the path, in the format [x, y].</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <array/>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="remove">      <shortdesc>Deletes the PathPoint.</shortdesc>    </method>    <method name="join">      <shortdesc>Join this path point to another path point. The two points must be end points and their paths combined into a single path on a single page item.</shortdesc>      <parameters>        <parameter name="reference">          <shortdesc>The reference object. The path point to join to</shortdesc>          <datatype>            <type>PathPoint</type>          </datatype>        </parameter>        <parameter name="given">          <shortdesc>The join option to use. (Optional)</shortdesc>          <datatype>            <type>JoinOptions</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the PathPoint.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>PathPoint</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>