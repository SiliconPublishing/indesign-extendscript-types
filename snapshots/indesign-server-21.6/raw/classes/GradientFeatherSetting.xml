<classdef name="GradientFeatherSetting" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Gradient feather effect settings.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the GradientFeatherSetting (a TransparencySetting, StrokeTransparencySetting, FillTransparencySetting or ContentTransparencySetting).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="opacityGradientStops" rwaccess="readonly">      <shortdesc>A collection of opacity gradient stops.</shortdesc>      <datatype>        <type>OpacityGradientStops</type>      </datatype>    </property>    <property name="applied">      <shortdesc>If true, the gradient feather effect is applied.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="type">      <shortdesc>The type of gradient.</shortdesc>      <datatype>        <type>GradientType</type>      </datatype>    </property>    <property name="angle">      <shortdesc>The angle of the gradient feather.</shortdesc>      <datatype>        <type>number</type>        <min>-180</min>        <max>180</max>      </datatype>    </property>    <property name="length">      <shortdesc>The length of the axial gradient, or radius of the radial gradient.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="gradientStart">      <shortdesc>The center point (for a radial gradient) or starting point (for a linear gradient) applied to the fill, as page coordinates in the format [x, y].</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>        <array/>      </datatype>    </property>    <property name="hiliteAngle">      <shortdesc>The hilite angle of the radial gradient feather.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="hiliteLength">      <shortdesc>The hilite length of the radial gradient feather.</shortdesc>      <datatype>        <type>Measurement Unit (Number or String)=any</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the GradientFeatherSetting.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>GradientFeatherSetting</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>