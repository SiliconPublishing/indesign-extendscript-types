<classdef name="FindGlyphPreference" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Find glyph preferences.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the FindGlyphPreference (a Application).</shortdesc>      <datatype>        <type>Application</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="designAxes">      <shortdesc>Value of Design Axes. Can return: Array of Reals or NothingEnum enumerator.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="glyphID">      <shortdesc>The GID/CID of the glyph. Can return: Long Integer or NothingEnum enumerator.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="rosFontGroup">      <shortdesc>The Registry Ordered font group. Can return: Array of 2 Strings or NothingEnum enumerator.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="appliedFont">      <shortdesc>The font applied to the FindGlyphPreference, specified as either a font object or the name of font family. Can return: Font, String or NothingEnum enumerator.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="fontStyle">      <shortdesc>The name of the font style. Can return: String or NothingEnum enumerator.</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="setNthDesignAxis">      <shortdesc>Set Nth design axis of a variable font.</shortdesc>      <parameters>        <parameter name="nthAxisIndex">          <shortdesc>Index of design axis.</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>        <parameter name="nthAxisValue">          <shortdesc>Value of nth design axis.</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>      </parameters>    </method>    <method name="isNthDesignAxisHidden">      <shortdesc>If true, Nth design axis of variable font is hidden.</shortdesc>      <parameters>        <parameter name="nthAxisIndex">          <shortdesc>Index of design axis.</shortdesc>          <datatype>            <type>number</type>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the FindGlyphPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>FindGlyphPreference</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>