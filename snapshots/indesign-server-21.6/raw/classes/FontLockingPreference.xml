<classdef name="FontLockingPreference" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>Font locking preferences.</shortdesc>  <elements type="instance">    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the FontLockingPreference (a Application).</shortdesc>      <datatype>        <type>Application</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="fontInputLocking">      <shortdesc>If true, turns on missing glyph protection during typing.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="fontChangeLocking">      <shortdesc>If true, turns on missing glyph protection during font change.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the FontLockingPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>FontLockingPreference</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>