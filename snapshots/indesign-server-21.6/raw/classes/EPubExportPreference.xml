<classdef name="EPubExportPreference" dynamic="true">  <superclass href="#/Preference">Preference</superclass>  <shortdesc>EPub export preferences.</shortdesc>  <elements type="instance">    <property name="level" rwaccess="readonly">      <shortdesc>The PNG compression level.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="isValid" rwaccess="readonly">      <shortdesc>Returns true if the object specifier resolves to valid objects.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="parent" rwaccess="readonly">      <shortdesc>The parent of the EPubExportPreference (a Book or Document).</shortdesc>      <datatype>        <type>varies=any</type>      </datatype>    </property>    <property name="events" rwaccess="readonly">      <shortdesc>A collection of events.</shortdesc>      <datatype>        <type>Events</type>      </datatype>    </property>    <property name="eventListeners" rwaccess="readonly">      <shortdesc>A collection of event listeners.</shortdesc>      <datatype>        <type>EventListeners</type>      </datatype>    </property>    <property name="epubPublisher">      <shortdesc>The epub publisher.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="id">      <shortdesc>The epub unique identifier, like ISBN.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="exportOrder">      <shortdesc>The export order.</shortdesc>      <datatype>        <type>ExportOrder</type>      </datatype>    </property>    <property name="epubCover">      <shortdesc>The epub cover option.</shortdesc>      <datatype>        <type>EpubCover</type>      </datatype>    </property>    <property name="coverImageFile">      <shortdesc>The epub cover image file path.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="bulletExportOption">      <shortdesc>The bullet export option.</shortdesc>      <datatype>        <type>BulletListExportOption</type>      </datatype>    </property>    <property name="numberedListExportOption">      <shortdesc>The numbered list export option.</shortdesc>      <datatype>        <type>NumberedListExportOption</type>      </datatype>    </property>    <property name="leftMargin">      <shortdesc>Left margin of the epub.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="rightMargin">      <shortdesc>Right margin of the epub.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="topMargin">      <shortdesc>Top margin of the epub.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="bottomMargin">      <shortdesc>Bottom margin of the epub.</shortdesc>      <datatype>        <type>number</type>      </datatype>    </property>    <property name="imageExportResolution">      <shortdesc>The export resolution</shortdesc>      <datatype>        <type>ImageResolution</type>      </datatype>    </property>    <property name="customImageSizeOption">      <shortdesc>Allows user to select the image size option for conversion</shortdesc>      <datatype>        <type>ImageSizeOption</type>      </datatype>    </property>    <property name="preserveLayoutAppearence">      <shortdesc>If true, format image based on layout appearence.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="imageAlignment">      <shortdesc>Alignment applied to images</shortdesc>      <datatype>        <type>ImageAlignmentType</type>      </datatype>    </property>    <property name="imageSpaceBefore">      <shortdesc>Space Before applied to images</shortdesc>      <datatype>        <type>number</type>        <min>0</min>        <max>8640</max>      </datatype>    </property>    <property name="imageSpaceAfter">      <shortdesc>Space After applied to images</shortdesc>      <datatype>        <type>number</type>        <min>0</min>        <max>8640</max>      </datatype>    </property>    <property name="useImagePageBreak">      <shortdesc>If true, image page break settings will be used in objects</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="imagePageBreak">      <shortdesc>Image page break settings to be used with objects</shortdesc>      <datatype>        <type>ImagePageBreakType</type>      </datatype>    </property>    <property name="imageConversion">      <shortdesc>The file format to use for converted images. Note: Valid only when copy optimized images and/or copy formatted images is true.</shortdesc>      <datatype>        <type>ImageConversion</type>      </datatype>    </property>    <property name="gifOptionsPalette">      <shortdesc>The color palette for GIF conversion. Note: Not valid when image conversion is JPEG.</shortdesc>      <datatype>        <type>GIFOptionsPalette</type>      </datatype>    </property>    <property name="gifOptionsInterlaced">      <shortdesc>If true, generates interlaced GIFs. Note: Not valid  when image conversion is JPEG.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="jpegOptionsQuality">      <shortdesc>The quality of converted JPEG images. Note: Not valid when image conversion is GIF.</shortdesc>      <datatype>        <type>JPEGOptionsQuality</type>      </datatype>    </property>    <property name="jpegOptionsFormat">      <shortdesc>The formatting method for converted JPEG images. Note: Not valid  when image conversion is GIF.</shortdesc>      <datatype>        <type>JPEGOptionsFormat</type>      </datatype>    </property>    <property name="ignoreObjectConversionSettings">      <shortdesc>ignore object level image conversion settings.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="tocStyleName">      <shortdesc>The name of TOC style to generate epub TOC.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="breakDocument">      <shortdesc>If  true, break InDesign document into smaller piece when generating epub.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="paragraphStyleName">      <shortdesc>The name of paragraph style to break InDesign document.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="stripSoftReturn">      <shortdesc>If  true, strip soft return.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="preserveLocalOverride">      <shortdesc>If true, output local style override.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="embedFont">      <shortdesc>If true, embed font in epub.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="externalStyleSheets">      <shortdesc>The file path of external cascading style sheets.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="javascripts">      <shortdesc>The file path of external javascripts.</shortdesc>      <datatype>        <type>string</type>        <array/>      </datatype>    </property>    <property name="version">      <shortdesc>The version of EPUB.</shortdesc>      <datatype>        <type>EpubVersion</type>      </datatype>    </property>    <property name="generateCascadeStyleSheet">      <shortdesc>If true, InDesign will generate cascade style sheet.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="footnotePlacement">      <shortdesc>The placement of footnote for EPub export</shortdesc>      <datatype>        <type>EPubFootnotePlacement</type>      </datatype>    </property>    <property name="epubTitle">      <shortdesc>The epub title.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubCreator">      <shortdesc>The epub creator.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubSubject">      <shortdesc>The epub subject.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubDescription">      <shortdesc>The epub description.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubDate">      <shortdesc>The epub date.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubRights">      <shortdesc>The epub rights.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="useExistingImageOnExport">      <shortdesc>If true, InDesign will use existing image for graphic objects on export.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="includeClassesInHTML">      <shortdesc>If true, InDesign will generate class attributes for elements in HTML, else will generate plain html without class attributes.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="useSVGAs">      <shortdesc>Use SVG As</shortdesc>      <datatype>        <type>UseSVGAsEnum</type>      </datatype>    </property>    <property name="epubAccessibilityFeature">      <shortdesc>The epub accessibility feature.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityHazard">      <shortdesc>The epub accessibility hazard.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityMode">      <shortdesc>The epub accessibility mode.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityModeSufficient">      <shortdesc>The epub accessibility mode sufficient.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilitySummary">      <shortdesc>The epub accessibility summary.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityConformsTo">      <shortdesc>The epub accessibility conforms to.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityCertifiedBy">      <shortdesc>The epub accessibility certified by.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityCredentials">      <shortdesc>The epub accessibility credentials.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubAccessibilityReportLink">      <shortdesc>The epub accessibility report link.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </property>    <property name="epubCreatePageNavigation">      <shortdesc>If true, The epub create page navigation.</shortdesc>      <datatype>        <type>bool</type>      </datatype>    </property>    <property name="properties">      <shortdesc>A property that allows setting of several properties at the same time.</shortdesc>      <datatype>        <type>Object</type>      </datatype>    </property>    <method name="toSource">      <shortdesc>Generates a string which, if executed, will return the EPubExportPreference.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="getElements">      <shortdesc>Resolves the object specifier, creating an array of object references.</shortdesc>      <datatype>        <type>EPubExportPreference</type>        <array/>      </datatype>    </method>    <method name="toSpecifier">      <shortdesc>Retrieves the object specifier.</shortdesc>      <datatype>        <type>string</type>      </datatype>    </method>    <method name="addEventListener">      <shortdesc>Adds an event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>EventListener</type>      </datatype>    </method>    <method name="removeEventListener">      <shortdesc>Removes the event listener.</shortdesc>      <parameters>        <parameter name="eventType">          <shortdesc>The registered event type.</shortdesc>          <datatype>            <type>string</type>          </datatype>        </parameter>        <parameter name="handler">          <shortdesc>The registered event handler. Can accept: File or JavaScript Function.</shortdesc>          <datatype>            <type>varies=any</type>          </datatype>        </parameter>        <parameter name="captures" optional="true">          <shortdesc>This parameter is obsolete. (Optional)</shortdesc>          <datatype>            <type>bool</type>            <value>false</value>          </datatype>        </parameter>      </parameters>      <datatype>        <type>bool</type>      </datatype>    </method>  </elements></classdef>