<classdef name="TableCaptionPositionOptions" enumeration="true">  <shortdesc>The position of caption paragraphs relative to the table.</shortdesc>  <elements type="class">    <property name="BEFORE_TABLE" rwaccess="readonly">      <shortdesc>Caption paragraphs precede the table.</shortdesc>      <datatype>        <type>number</type>        <value>1415725890</value>      </datatype>    </property>    <property name="AFTER_TABLE" rwaccess="readonly">      <shortdesc>Caption paragraphs follow the table.</shortdesc>      <datatype>        <type>number</type>        <value>1415725889</value>      </datatype>    </property>  </elements></classdef>